+    let mut ui_startup=serde_json::Map::new();
+    for (name,address,bytes) in [("recInitMachineState",0x1a61b70,2),("menuPermitRaw",0x10aa094,1),("keyMachineState",0x1a61bcc,2),("phase",0x10a72ec,2),("expectedInitComplete",0x10a7378,4),
