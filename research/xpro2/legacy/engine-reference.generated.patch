+    } else { None };
+    let lcd = if std::env::var("XPRO2_DUMP_LCD").as_deref()==Ok("1") {
+        if let Some(frame)=session.frame(0)? {
+            let path=target.with_extension(format!("{}-lcd.rgba",std::process::id()));
+            std::fs::write(&path,&frame.rgba)?;
+            Some(json!({"path":path,"width":frame.width,"height":frame.height,
+                "sha256":fujimod_firmware::sha256(&frame.rgba)}))
+        } else { None }
+    } else { None };
+    let preference_file=if std::env::var("XPRO2_READ_PREF_FILE").as_deref()==Ok("1") {
+        let limit=std::env::var("XPRO2_PREF_FILE_BYTES").unwrap_or("16".into()).parse::<usize>()?;
+        if !(4..=128).contains(&limit) || limit%4!=0 {return Err("preference file capture must be4..128 aligned bytes".into());}
+        Some(session.core.card_read("sd","/OPACITY.BIN",None,limit).map(|bytes|json!({
+            "bytes":bytes.len(),"sha256":fujimod_firmware::sha256(&bytes),
+            "words":bytes.chunks_exact(4).map(|v|u32::from_le_bytes(v.try_into().unwrap())).collect::<Vec<_>>()
+        })))
+    }else{None};
+    let mut report=json!({
+            "reused":reused,"snapshot":args[3],"exportedAfter":exported_after,"lcd":lcd,"ramExport":ram_export,"gpio":gpio_export,"devices":devices_export,"armException":arm_exception,"controlRuns":control_runs,"coldCycle":cold_cycle,
+            "registers":if std::env::var("XPRO2_DUMP_REGISTERS").as_deref()==Ok("1") {Some((0..2).map(|core|(0..16).map(|index|session.core.board.read_register(core,fujimod_emulator_cpu::Register::Arm32(fujimod_emulator_cpu::arm::Register::R(index)))).collect::<Vec<_>>()).collect::<Vec<_>>())}else{None},
+            "timers":board_state["bus"]["devices"].as_array().and_then(|devices|devices.iter().find(|device|device["kind"]=="xpp-timers")).map(|device|device["state"].clone()),
+            "snapshotSha256":fujimod_firmware::sha256(&std::fs::read(&target)?),
+            "tick":session.core.board.now(),"instructions":session.core.board.instruction_counts(),
+            "uiMachineStates":states.chunks_exact(2).map(|b|u16::from_le_bytes([b[0],b[1]])).collect::<Vec<_>>(),
+            "uiWrites":ui_writes,"uiInstructions":ui_instructions,"osdBefore":osd_before,"osdAfter":osd_after,"pipeline":pipeline,"gic":interrupt_state,"pcs":(0..2).map(|core|session.core.board.read_register(core,fujimod_emulator_cpu::Register::Pc)).collect::<Vec<_>>(),
+            "dmp":dmp,"adcSamples":session.core.adc_samples("adc")?,"lensGpio":lens_gpio,"diagnosticWords":diagnostic_words,"virtualDiagnostics":virtual_diagnostics,"recActiveMachines":rec_active,"recStates":rec_states,"recEvents":rec_events,"lensData":lens_data,"taskStates":task_states,"uiStartup":ui_startup,"shutterRows":shutter_rows,"irqCallbacks":irq_callbacks,"keyGlobals":key_globals,"rowProbe":row_probe,"cards":cards,"pcEntries":session.core.board.pc_entries(),"state":session.session_state()?
+        });
+    report["preferenceFile"]=serde_json::to_value(preference_file)?;
+    report["guideCases"]=serde_json::to_value(guide_cases)?;
+    report["armExceptionsByCore"]=serde_json::to_value((0..2).map(|core| {
+        let read=|crn,opc2| session.core.board.cpu(core)?.coprocessor(
+            fujimod_emulator_cpu::arm::Coprocessor{cp:15,opc1:0,crn,crm:0,opc2,secure:0,wide:false},None);
+        Ok::<_,String>(json!({"core":core,"dfsr":read(5,0)?,"ifsr":read(5,1)?,"dfar":read(6,0)?,"ifar":read(6,2)?}))
+    }).collect::<Result<Vec<_>,_>>()?)?;
+    println!("{}",serde_json::to_string_pretty(&report)?);
+    Ok(())
+}
diff --git a/bindings/javascript/emulator/examples/xpro2_quantum_bench.rs b/bindings/javascript/emulator/examples/xpro2_quantum_bench.rs
new file mode 100644
index 00000000..44dc2444
--- /dev/null
+++ b/bindings/javascript/emulator/examples/xpro2_quantum_bench.rs
@@ -0,0 +1,60 @@
+//! Measure a declared scheduler batch from its own retained camera state.
+use fujimod_emulator_javascript::Session;
+use serde_json::{Value,json};
+use std::{path::PathBuf,time::Instant};
+
+fn advance(s:&mut Session, quantum:usize, ticks:u64)->Result<(),String>{
+    let start:u64=s.core.board.instruction_counts().iter().sum();
+    s.core.run_with_limits(u64::MAX-start,quantum,None,Some(s.core.board.now()+ticks))
+}
+fn words(s:&Session,address:u64,count:usize)->Result<Vec<u32>,String>{
+    let mut raw=vec![0;count*4];s.core.board.read_physical(address,&mut raw)?;
+    Ok(raw.chunks_exact(4).map(|v|u32::from_le_bytes(v.try_into().unwrap())).collect())
+}
+fn osd(s:&Session)->Result<String,String>{
+    let state=s.core.board.state();
+    let node=state["bus"]["devices"].as_array().ok_or("devices")?.iter()
+        .find(|v|v["kind"]=="xpp-display-output").ok_or("display")?;
+    let w=node["state"]["words"].as_array().ok_or("words")?;
+    let word=|at:u64|w.iter().find(|v|v[0].as_u64()==Some(at)).and_then(|v|v[1].as_u64()).unwrap_or(0);
+    let size=word(0x220);let n=(((size>>16)&0xfff)+1)*((size&0xfff)+1)*4;
+    if n>16_000_000 || word(0x230)==0{return Err("invalid output".into());}
+    let mut raw=vec![0;n as usize];s.core.board.read_physical(word(0x230),&mut raw)?;
+    Ok(fujimod_firmware::sha256(&raw))
+}
+fn main()->Result<(),Box<dyn std::error::Error>>{
+    let args:Vec<_>=std::env::args().collect();
+    if args.len()!=3{return Err("SNAPSHOT OUTPUT.json".into());}
+    let bytes=std::fs::read(&args[1])?;let mut results:Vec<Value>=vec![];
+    // A running board fixes its quantum. Never change it underneath a loaded
+    // snapshot; another candidate needs a fresh graph/boot of its own.
+    let declared=Session::load_snapshot(&bytes)?.core.definition["graph"]["quantum"]
+        .as_u64().ok_or("snapshot has no declared scheduler quantum")? as usize;
+    for quantum in [declared]{
+        let mut s=Session::load_snapshot(&bytes)?;
+        let before=words(&s,0x1003980,8)?;let tick=s.core.board.now();
+        let counts=s.core.board.instruction_counts().to_vec();let clock=Instant::now();
+        for control in ["selector.down","selector.up"]{
+            s.press(control.into(),None)?;advance(&mut s,quantum,4_800_000)?;
+            s.release(control.into())?;advance(&mut s,quantum,4_800_000)?;
+            advance(&mut s,quantum,12_000_000)?;
+        }
+        let elapsed=clock.elapsed().as_secs_f64();
+        let row=json!({"quantum":quantum,"seconds":elapsed,"guest_ticks":s.core.board.now()-tick,
+            "instructions_before":counts,"instructions_after":s.core.board.instruction_counts(),
+            "menu_before":before,"menu_after":words(&s,0x1003980,8)?,
+            "opacity":words(&s,0x103b00,4)?,"theme":words(&s,0x90700,1)?,
+            "preferences":words(&s,0x102400,18)?,"osd_sha256":osd(&s)?});
+        eprintln!("quantum {quantum}: {elapsed:.3}s");results.push(row);
+    }
+    let baseline=results[0]["seconds"].as_f64().ok_or("baseline")?;
+    for row in &mut results{
+        row["speedup"]=json!(baseline/row["seconds"].as_f64().ok_or("timing")?);
+    }
+    std::fs::write(PathBuf::from(&args[2]),serde_json::to_vec_pretty(&json!({
+        "schema":1,"snapshot_sha256":fujimod_firmware::sha256(&bytes),"results":results,
+        "scope":"Native scheduler benchmark; browser speed requires separate verification",
+        "firmware_and_timer_rate_changed":false
+    }))?)?;
+    Ok(())
+}
diff --git a/bindings/javascript/emulator/examples/xpro2_rom_boot.rs b/bindings/javascript/emulator/examples/xpro2_rom_boot.rs
new file mode 100644
index 00000000..ed5a38de
--- /dev/null
+++ b/bindings/javascript/emulator/examples/xpro2_rom_boot.rs
@@ -0,0 +1,100 @@
+//! Execute a declared sibling Agate ROM against virtual SD files, without DRAM preload.
+use fujimod_emulator_cpu::{ExecutionPolicy, Register};
+use fujimod_emulator_javascript::Session;
+use serde_json::json;
+use std::path::PathBuf;
+
+struct Handoff {
+    cpu: std::rc::Rc<dyn fujimod_emulator_cpu::Cpu>,
+    sha256: Option<String>,
+    error: Option<String>,
+}
+unsafe fn handoff(_:u64, _:u32, data:*mut std::ffi::c_void) {
+    let observed=unsafe { &mut *data.cast::<Handoff>() };
+    if observed.sha256.is_some() || observed.error.is_some() {return;}
+    let mut image=vec![0;40235008];
+    match observed.cpu.read_memory(0,&mut image) {
+        Ok(()) => observed.sha256=Some(fujimod_firmware::sha256(&image)),
+        Err(error) => observed.error=Some(error.to_string()),
+    }
+}
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    let args: Vec<_> = std::env::args().collect();
+    if args.len() != 6 { return Err("ROOT GRAPH INPUT OUTPUT_PREFIX TICKS".into()); }
+    let root = PathBuf::from(&args[1]);
+    let prefix = root.join(&args[4]);
+    if !prefix.starts_with(root.join("analysis")) || prefix.components().any(|p| matches!(p, std::path::Component::ParentDir)) {
+        return Err("output must be under analysis".into());
+    }
+    let mut handoffs: Vec<Box<Handoff>> = Vec::new();
+    let mut s = Session::create_camera(&std::fs::read(root.join(&args[2]))?,
+        &std::fs::read(root.join(&args[3]))?, ExecutionPolicy::Exact)?;
+    let files = [("/FFSYS.BIN", 2048), ("/FFBOOT.BIN", 40235008)].into_iter().map(|(path, size)| {
+        match s.core.card_read("sd", path, None, size) {
+            Ok(bytes) => json!({"path":path,"bytes":bytes.len(),"sha256":fujimod_firmware::sha256(&bytes)}),
+            Err(error) => json!({"path":path,"error":error}),
+        }
+    }).collect::<Vec<_>>();
+    let mut initial = [0;64];
+    s.core.board.read_physical(0x40000000, &mut initial)?;
+    if initial.iter().any(|b| *b != 0) { return Err("DRAM is not initially empty".into()); }
+    let boot_source=std::env::var("XPRO2_ROM_BOOT_SOURCE").unwrap_or("sd".into());
+    if !matches!(boot_source.as_str(),"sd"|"nor") {return Err("boot source must be sd or nor".into());}
+    s.core.logic_input("lab.sd_boot_strap", boot_source=="sd")?;
+    let mut observed_pcs=vec![0,0x100,0x103000,0xfff00020,0xfff01888,0xfff019d4,0xfff01c04,0xfff027b8,0xfff02880];
+    if let Ok(extra)=std::env::var("XPRO2_ROM_WATCH_PCS") {
+        if extra.split(',').count()>16 {return Err("too many observed PCs".into());}
+        for item in extra.split(',') {observed_pcs.push(u64::from_str_radix(item.trim_start_matches("0x"),16)?);}
+    }
+    observed_pcs.sort_unstable();observed_pcs.dedup();
+    s.core.board.watch_pcs(&observed_pcs)?;
+    handoffs.push(Box::new(Handoff{cpu:s.core.board.cpu_handle(0)?,sha256:None,error:None}));
+    let hook=unsafe { s.core.board.cpu(0)?.install_hook(fujimod_emulator_cpu::Hook::Instruction {
+        callback:handoff, data:(&mut **handoffs.last_mut().unwrap() as *mut Handoff).cast(),
+        range:fujimod_emulator_cpu::HookRange::Inclusive{begin:0,end:0},
+    })? };
+    let limit = args[5].parse::<u64>()?;
+    if limit == 0 || limit > 2_000_000_000 { return Err("tick budget outside1..2G".into()); }
+    let mut failure = None;
+    while s.core.board.now() < limit {
+        let until = s.core.board.now().saturating_add(12_000_000).min(limit);
+        if let Err(error) = s.run(until) { failure=Some(error); break; }
+        eprintln!("ROM probe tick {}", s.core.board.now());
+    }
+    s.core.board.cpu(0)?.remove_hook(hook)?;
+    let cores = (0..2).map(|core| {
+        let registers = (0..16).map(|r| s.core.board.read_register(core,
+            Register::Arm32(fujimod_emulator_cpu::arm::Register::R(r)))).collect::<Vec<_>>();
+        let fault=(|| -> Result<_,String> {
+            let cpu=s.core.board.cpu(core)?;
+            let cp15=|crn,opc2|cpu.coprocessor(fujimod_emulator_cpu::arm::Coprocessor {
+                cp:15,opc1:0,crn,crm:0,opc2,secure:0,wide:false},None);
+            Ok(json!({"dfsr":cp15(5,0)?,"ifsr":cp15(5,1)?,"dfar":cp15(6,0)?,"ifar":cp15(6,2)?}))
+        })();
+        json!({"core":core,"registers":registers,"fault":fault})
+    }).collect::<Vec<_>>();
+    let frame = if let Some(frame) = s.frame(0)? {
+        let path=prefix.with_extension("rgba");
+        std::fs::write(&path,&frame.rgba)?;
+        Some(json!({"path":path,"width":frame.width,"height":frame.height,"sha256":fujimod_firmware::sha256(&frame.rgba)}))
+    } else {None};
+    let state = s.core.board.state();
+    let device_path = prefix.with_extension("devices.cbor");
+    let mut device_file = std::fs::File::create(&device_path)?;
+    ciborium::into_writer(&state["bus"]["devices"],&mut device_file)?;
+    let snapshot=if failure.is_none() && handoffs[0].sha256.is_some() {
+        let bytes=s.export_snapshot()?.snapshot;
+        let path=prefix.with_extension("snapshot.bin");
+        std::fs::write(&path,&bytes)?;
