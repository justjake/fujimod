{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": [],
    "skipLibCheck": true
  },
  "include": [
    "node_modules/@cloudflare/workers-types/index.d.ts",
    "worker.ts",
    "issue-reports.ts",
    "error-logs.ts",
    "client-error-log.ts",
    "bucket.ts",
    "env.ts",
    "../domain-endpoint/worker.ts"
  ]
}
