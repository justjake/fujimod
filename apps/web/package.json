{
  "name": "fujimod-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:generate": "auth generate --config src/auth/cli.ts --adapter drizzle --dialect sqlite --output src/db/auth-schema.generated.ts --yes",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate:list": "cf d1 migrations list 29375cc8-35ff-4559-ad3a-05d977dfde89 --dir . --pattern 'drizzle/*.sql'",
    "db:migrate:local": "cf d1 migrations apply 29375cc8-35ff-4559-ad3a-05d977dfde89 --local --dir . --pattern 'drizzle/*.sql'",
    "db:migrate:remote": "cf d1 migrations apply 29375cc8-35ff-4559-ad3a-05d977dfde89 --dir . --pattern 'drizzle/*.sql'",
    "dev": "vp dev --host 127.0.0.1",
    "build": "vp check --no-fmt && vp build && node scripts/prerender.ts dist",
    "preview": "vp preview --host 127.0.0.1",
    "test": "pnpm --filter @fujimod/emulator-ui test && vp test run",
    "build:local-preview": "vp check --no-fmt && vp build --mode local-preview && node scripts/prerender.ts dist-local-preview",
    "test:watch": "vp test",
    "check": "vp check --no-fmt && node scripts/icon-metrics.ts --check && pnpm --filter @fujimod/emulator-ui run check",
    "icons:metrics": "node scripts/icon-metrics.ts",
    "lint": "vp lint && pnpm --filter @fujimod/emulator-ui run lint",
    "format": "vp fmt && pnpm --filter @fujimod/emulator-ui run format",
    "docs:solid": "node scripts/fetch-solid-docs.ts",
    "format:check": "vp fmt --check && pnpm --filter @fujimod/emulator-ui run format:check",
    "build:usb": "pnpm --filter fujimod run build",
    "predev": "pnpm run build:usb",
    "prebuild": "pnpm run build:usb",
    "prebuild:local-preview": "pnpm run build:usb",
    "pretest": "pnpm run build:usb && node ../../crates/simulation/build-web.ts",
    "precheck": "pnpm run build:usb",
    "test:debug-mode:browser": "node src/dev-tools/debug-mode/browser.ts",
    "test:dev-tools:browser": "node src/dev-tools/browser.ts",
    "test:layout-editor:browser": "node src/home/layout-editor.browser.ts",
    "test:prerender": "node scripts/test-prerender.ts",
    "deploy": "node scripts/deploy.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@fujimod/emulator-ui": "workspace:*",
    "@solidjs/web": "2.0.0-rc.20",
    "better-auth": "1.7.18",
    "drizzle-orm": "^0.45.4",
    "fujimod": "workspace:*",
    "solid-js": "2.0.0-rc.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.5",
    "auth": "1.7.18",
    "drizzle-kit": "^0.31.11",
    "eslint-plugin-solid": "0.18.1",
    "jsdom": "30.1.3",
    "miniflare": "5.20261012.1-beta",
    "playwright": "1.64.1",
    "playwright-core": "1.64.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
    "vite-plus": "1.3.0"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
