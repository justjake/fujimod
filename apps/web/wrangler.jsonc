{
  "$schema": "../usb-sharing/node_modules/wrangler/config-schema.json",
  "name": "fujimod-web",
  "account_id": "1edee8e500839ee3dbf7338f44503075",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "main": "worker.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/auth/*", "/api/devices/*", "/releases/*", "/ota/*"],
    "not_found_handling": "404-page",
  },
  "kv_namespaces": [{ "binding": "RELEASES", "id": "0d69f6a209314bf899f93649577eb3e4" }],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "fujimod-auth",
      "database_id": "29375cc8-35ff-4559-ad3a-05d977dfde89",
      "migrations_dir": "./drizzle",
      "migrations_table": "d1_migrations",
    },
  ],
  "vars": {
    "GOOGLE_CLIENT_ID": "272973133287-gl3k5a4hhqg1ckcojl5cdkriretmb4cs.apps.googleusercontent.com",
  },
  "routes": [
    { "pattern": "fujimod.com", "custom_domain": true },
    { "pattern": "www.fujimod.com", "custom_domain": true },
  ],
}
