{
  "$schema": "../usb-sharing/node_modules/wrangler/config-schema.json",
  "name": "fujimod-web",
  "account_id": "1edee8e500839ee3dbf7338f44503075",
  "compatibility_date": "2026-10-17",
  "workers_dev": false,
  "main": "worker.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/releases/*", "/ota/*"],
    "not_found_handling": "404-page",
  },
  "kv_namespaces": [{ "binding": "RELEASES", "id": "0d69f6a209314bf899f93649577eb3e4" }],
  "routes": [
    { "pattern": "fujimod.com", "custom_domain": true },
    { "pattern": "www.fujimod.com", "custom_domain": true },
  ],
}
