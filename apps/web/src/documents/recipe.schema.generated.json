{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "settings_recipe_file",
  "title": "Recipes",
  "x-document": {
    "id": "recipe",
    "directory": "FUJIMOD/RECIPES",
    "extensions": [
      ".JSN",
      ".JSO"
    ],
    "new_name": "RECIP###.JSN"
  },
  "x-locked-by": "protected",
  "x-groups": [
    {
      "title": "RECIPE",
      "properties": [
        "name",
        "description",
        "protected"
      ]
    },
    {
      "title": "CREDITS",
      "properties": [
        "author",
        "author_url",
        "source_attribution",
        "source_url",
        "based_on",
        "remixed_by",
        "remixed_by_url"
      ]
    },
    {
      "title": "IMAGE QUALITY SETTING",
      "properties": [
        "film_simulation",
        "grain_roughness",
        "grain_size",
        "color_chrome_effect",
        "color_chrome_fx_blue",
        "dynamic_range",
        "d_range_priority",
        "highlight",
        "shadow",
        "color",
        "sharpness",
        "high_iso_nr",
        "clarity"
      ]
    },
    {
      "title": "WHITE BALANCE",
      "properties": [
        "white_balance",
        "wb_kelvin",
        "white_balance_red",
        "white_balance_blue"
      ]
    },
    {
      "title": "EXPOSURE",
      "properties": [
        "iso",
        "exposure_compensation_thirds",
        "auto_iso1",
        "auto_iso2",
        "auto_iso3"
      ]
    },
    {
      "title": "FILM EFFECTS",
      "properties": [
        "halation_strength",
        "halation_color",
        "halation_size",
        "light_leaks",
        "light_leaks_color",
        "light_leaks_expired",
        "film_borders",
        "film_borders_style",
        "negative",
        "date_stamp",
        "date_stamp_style",
        "date_stamp_format",
        "date_stamp_corner",
        "mist"
      ]
    }
  ],
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stock_choices": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "values": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "setting"
            ],
            "properties": {
              "setting": {
                "type": "string",
                "minLength": 1,
                "maxLength": 63
              },
              "value": {
                "type": "string",
                "maxLength": 63,
                "default": ""
              },
              "stock": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535,
                "default": 0
              }
            }
          }
        }
      },
      "title": "CAMERA SLOT CHOICES",
      "readOnly": true
    },
    "v": {
      "title": "VERSION",
      "readOnly": true,
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "default": 1
    },
    "name": {
      "title": "NAME",
      "type": "string",
      "maxLength": 63,
      "default": "Recipe"
    },
    "author": {
      "title": "AUTHOR",
      "type": "string",
      "maxLength": 127,
      "default": ""
    },
    "description": {
      "title": "DESCRIPTION",
      "type": "string",
      "maxLength": 511,
      "default": ""
    },
    "protected": {
      "title": "PROTECT",
      "description": "The file cannot be changed or erased; the preset set ships protected.",
      "type": "boolean",
      "default": false
    },
    "source_url": {
      "title": "SOURCE URL",
      "type": "string",
      "maxLength": 255,
      "default": ""
    },
    "source_attribution": {
      "title": "SOURCE",
      "type": "string",
      "maxLength": 127,
      "default": ""
    },
    "based_on": {
      "title": "BASED ON",
      "x-reference": "recipe",
      "description": "Filename of the credited recipe this one was saved from: RECIPES saves an edit of a credited recipe as a copy, which is the user's own.",
      "type": "string",
      "maxLength": 12,
      "default": ""
    },
    "author_url": {
      "title": "AUTHOR URL",
      "description": "The author's web address.",
      "type": "string",
      "maxLength": 255,
      "default": ""
    },
    "remixed_by_url": {
      "title": "REMIXED BY URL",
      "description": "The remixer's web address.",
      "type": "string",
      "maxLength": 255,
      "default": ""
    },
    "remixed_by": {
      "title": "REMIXED BY",
      "description": "Owner name of the camera that saved this recipe from another one (a copy, or the current settings saved while it was selected).",
