{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fujimod.com/schemas/corpus-unit.schema.json",
  "title": "Corpus unit input",
  "type": "object",
  "required": ["firmware", "unit", "architecture", "address_ranges", "functions"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "firmware": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "architecture": {
      "enum": ["arm32", "aarch64"]
    },
    "address_ranges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/range"
      }
    },
    "functions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/function"
      }
    },
    "address_aliases": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "$ref": "#/$defs/address"
          },
          {
            "$ref": "#/$defs/address"
          },
          {
            "$ref": "#/$defs/address"
          }
        ],
        "minItems": 3,
        "items": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "address": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "range": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/address"
        },
        {
          "$ref": "#/$defs/address"
        }
      ],
      "items": false,
      "minItems": 2
    },
    "annotation": {
      "type": "object",
      "required": ["kind", "text", "source"],
      "properties": {
        "kind": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "required": ["site", "target", "kind"],
      "properties": {
        "site": {
          "$ref": "#/$defs/address"
        },
        "target": {
          "$ref": "#/$defs/address"
        },
        "kind": {
          "type": "string"
        },
        "text": {
          "type": ["string", "null"]
        }
      },
      "additionalProperties": false
    },
    "function": {
      "type": "object",
      "required": ["address", "ranges"],
      "properties": {
        "address": {
          "$ref": "#/$defs/address"
        },
        "ranges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/range"
          }
        },
        "names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/annotation"
          }
        },
        "references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
