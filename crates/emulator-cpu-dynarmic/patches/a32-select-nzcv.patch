@@ -21,6 +21,32 @@ namespace Dynarmic::Optimization {

 namespace {

+void ForwardSelectFlags(IR::Block& block) {
+    IR::Value flags;
+    for (auto inst = block.begin(); inst != block.end(); ++inst) {
+        switch (inst->GetOpcode()) {
+        case IR::Opcode::A32SetCpsrNZCV:
+            flags = inst->GetArg(0);
+            break;
+        case IR::Opcode::ConditionalSelect32:
+            if (!flags.IsEmpty()) {
+                // The select can consume the IR producer directly. FlagsPass
+                // can then eliminate flag writes overwritten in this block.
+                auto select = block.PrependNewInst(inst, IR::Opcode::ConditionalSelect32WithNZCV,
+                    {inst->GetArg(0), inst->GetArg(1), inst->GetArg(2), flags});
+                inst->ReplaceUsesWith(IR::Value{&*select});
+            }
+            break;
+        default:
+            if (inst->WritesToCPSR() || inst->IsMemoryReadOrWrite()
+                || inst->IsCoprocessorInstruction() || inst->GetOpcode() == IR::Opcode::CallHostFunction) {
+                flags = {};
+            }
+            break;
+        }
+    }
+}
