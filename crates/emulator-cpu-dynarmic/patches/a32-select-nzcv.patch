+template<>
+void EmitIR<IR::Opcode::ConditionalSelect32WithNZCV>(oaknut::CodeGenerator& code, EmitContext& ctx, IR::Inst* inst) {
+    auto args = ctx.reg_alloc.GetArgumentInfo(inst);
+    const auto cond = static_cast<oaknut::Cond>(args[0].GetImmediateCond());
+    auto Wresult = ctx.reg_alloc.WriteW(inst);
+    auto Wthen = ctx.reg_alloc.ReadW(args[1]);
+    auto Welse = ctx.reg_alloc.ReadW(args[2]);
+    RegAlloc::Realize(Wresult, Wthen, Welse);
+    if (args[3].IsImmediate() || args[3].CurrentLocationKind() != HostLoc::Kind::Flags) {
+        ctx.reg_alloc.SpillFlags();
+        auto Wnzcv = ctx.reg_alloc.ReadW(args[3]);
+        RegAlloc::Realize(Wnzcv);
+        code.MSR(oaknut::SystemReg::NZCV, Wnzcv->toX());
+    }
+    code.CSEL(Wresult, Wthen, Welse, cond);
+}
