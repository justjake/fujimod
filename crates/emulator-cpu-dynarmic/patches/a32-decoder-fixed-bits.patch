+    // Skip the matcher scan when the opcode violates a fixed bit shared by
+    // all encodings in this table, without duplicating the opcode patterns.
+    static constexpr auto fixed = []() consteval {
+        typename Decoder::detail::detail<VFPMatcher<V>>::FixedBits bits;
+#define INST(fn, name, bitstring) bits.Add(bitstring);
+#include "./vfp.inc"
+#undef INST
+        return bits;
+    }();
+    if (!fixed.Matches(instruction)) {
+        return std::nullopt;
+    }
