         return std::make_tuple(mask, expect);
     }

+    struct FixedBits {
+        opcode_type required = ~opcode_type{0};
+        opcode_type forbidden = ~opcode_type{0};
+
+        consteval void Add(const char (&pattern)[opcode_bitsize + 1]) {
+            const auto [mask, expect] = GetMaskAndExpect(StringToArray<opcode_bitsize>(pattern));
+            required &= expect;
+            forbidden &= mask & ~expect;
+        }
+
+        constexpr bool Matches(opcode_type instruction) const {
+            return (instruction & (required | forbidden)) == required;
+        }
+    };
+
     /**
      * Generates the masks and shifts for each argument.
      * A '-' in a bitstring indicates that we don't care about that value.
