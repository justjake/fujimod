+void A32EmitX64::EmitCheckCycleBudget(const A32EmitContext& ctx, size_t cycles) {
+    if (!conf.enable_cycle_counting || !conf.check_cycle_budget || ctx.IsSingleStep() || cycles == 0) {
+        return;
+    }
+
+    ASSERT(cycles < std::numeric_limits<s32>::max());
+    Xbyak::Label fits;
+    code.cmp(qword[rsp + ABI_SHADOW_SPACE + offsetof(StackLayout, cycles_remaining)], static_cast<u32>(cycles));
+    code.jge(fits);
+    // Linked blocks can reach this entry without updating the stored guest PC.
+    code.mov(MJitStateReg(A32::Reg::PC), ctx.Location().PC());
+    code.ForceReturnFromRunCode();
+    code.L(fits);
+}
