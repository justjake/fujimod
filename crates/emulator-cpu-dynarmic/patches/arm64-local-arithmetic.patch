+static IR::Value WithoutIdentity(IR::Value value) {
+    while (value.IsIdentity()) {
+        value = value.GetInst()->GetArg(0);
+    }
+    return value;
+}
+
+static bool SameOperand(IR::Value left, IR::Value right) {
+    left = WithoutIdentity(left);
+    right = WithoutIdentity(right);
+    if (left.IsImmediate() != right.IsImmediate()) {
+        return false;
+    }
+    return left.IsImmediate()
+        ? left.GetImmediateAsU64() == right.GetImmediateAsU64()
+        : left.GetInst() == right.GetInst();
+}
+
+// Compilers often compare a shifted operand and then conditionally perform
+// the same subtraction. Keep this search local to limit compile time and
+// host register lifetimes.
+static void ReuseLocalArithmetic(IR::Block& block) {
+    std::array<IR::Inst*, 8> recent{};
+    size_t next = 0;
+    for (auto& inst : block) {
+        switch (inst.GetOpcode()) {
+        case IR::Opcode::Add32:
+        case IR::Opcode::Sub32:
+        case IR::Opcode::LogicalShiftLeft32:
+        case IR::Opcode::LogicalShiftRight32:
+        case IR::Opcode::ArithmeticShiftRight32:
+        case IR::Opcode::RotateRight32:
+            break;
+        default:
+            continue;
+        }
+
+        if (!inst.HasAssociatedPseudoOperation()) {
+            for (IR::Inst* prior : recent) {
+                if (prior && prior->GetOpcode() == inst.GetOpcode()
+                    && SameOperand(prior->GetArg(0), inst.GetArg(0))
+                    && SameOperand(prior->GetArg(1), inst.GetArg(1))
+                    && SameOperand(prior->GetArg(2), inst.GetArg(2))) {
+                    inst.ReplaceUsesWith(IR::Value{prior});
+                    break;
+                }
+            }
+        }
+        if (inst.GetOpcode() != IR::Opcode::Identity) {
+            recent[next] = &inst;
+            next = (next + 1) % recent.size();
+        }
+    }
+}
