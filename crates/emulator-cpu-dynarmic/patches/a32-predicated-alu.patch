 namespace Dynarmic::A32 {
+namespace {
+
+bool CanSelectArmResult(ConditionalState state, Cond cond, Reg dest, bool set_flags) {
+    // These forms have no effect except the destination write. Selecting the
+    // old value on the false path keeps them inside an unconditional block.
+    return state == ConditionalState::None
+        && cond != Cond::AL && cond != Cond::NV && dest != Reg::PC && !set_flags;
+}
