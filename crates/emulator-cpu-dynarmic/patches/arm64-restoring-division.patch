+static u64 TryRestoringDivision(A32JitState& state, s64 budget, u32 operands) {
+    constexpr u32 cost = IR::A32RestoringDivision::instruction_count;
+    if (budget < cost) {
+        return 0;
+    }
+    auto& remainder = state.regs[operands & 15];
+    auto& divisor = state.regs[(operands >> 4) & 15];
+    auto& place = state.regs[(operands >> 8) & 15];
+    auto& quotient = state.regs[operands >> 12];
+
+    // The usual division invariant aligns the scaled divisor with the
+    // one-bit place. Other incoming states execute the original block.
+    if (!std::has_single_bit(place) || (divisor & (place - 1)) != 0 || divisor == 0) {
+        return 0;
+    }
+    const u32 position = std::countr_zero(place);
+    const u32 unit = divisor >> position;
+    const u32 digit = remainder / unit;
+    if (digit > ((place - 1) << 1 | 1)) {
+        return 0;
+    }
+
+    u32 rest = remainder - digit * unit;
+    const u32 last_bit = rest != 0 ? 0 : digit == 0 ? position : std::countr_zero(digit);
+    const u32 groups = (position - last_bit) / 4 + 1;
+    const u32 ticks = groups * cost;
+    if (budget < ticks) {
+        return 0;
+    }
+
+    const u32 discarded = (groups - 1) * 4;
+    divisor >>= discarded;
+    place >>= discarded;
+    quotient |= digit;
+
+    if (rest != 0) {
+        // In a partial final group the remaining comparisons can reduce
+        // the remainder even after the shifted place becomes zero.
+        for (u32 shift = position % 4 + 1; shift != 4; ++shift) {
+            const u32 part = divisor >> shift;
+            if (rest >= part) {
+                rest -= part;
+            }
+        }
+    }
+    remainder = rest;
+    constexpr u32 zero = 1 << 30;
+    constexpr u32 carry = 1 << 29;
+    state.cpsr_nzcv = zero;
+    if (rest == 0) {
+        state.cpsr_nzcv |= carry;
+    } else {
+        if (place & 8) {
+            state.cpsr_nzcv |= carry;
+        }
+        place = 0;
+    }
+    return ticks;
+}
+
+void EmitA32RestoringDivision(oaknut::CodeGenerator& code, EmitContext& ctx, IR::A32RestoringDivision division) {
+    using namespace oaknut::util;
+    const u32 operands = u32(division.remainder) | u32(division.divisor) << 4
+                       | u32(division.place) << 8 | u32(division.quotient) << 12;
+    oaknut::Label ordinary;
+    code.MOV(X0, Xstate);
+    code.MOV(X1, Xticks);
+    code.MOV(W2, operands);
+    code.MOV(Xscratch0, reinterpret_cast<u64>(&TryRestoringDivision));
+    code.BLR(Xscratch0);
+    code.CBZ(X0, ordinary);
+    code.SUB(Xticks, Xticks, X0);
+    const auto location = A32::LocationDescriptor{ctx.block.Location()};
+    const auto next = location.AdvancePC(4 * IR::A32RestoringDivision::instruction_count);
+    EmitA32Terminal(code, ctx, IR::Term::LinkBlock{next}, location, false);
+    code.l(ordinary);
+}
+
 void EmitA32Terminal(oaknut::CodeGenerator& code, EmitContext& ctx, IR::Term::LinkBlockFast terminal, IR::LocationDescriptor initial_location, bool is_single_step) {
     EmitA32Terminal(code, ctx, IR::Term::LinkBlock{terminal.next}, initial_location, is_single_step);
 }
