  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowJs": false,
    "noEmitOnError": true,
    "rewriteRelativeImportExtensions": true,
    "declaration": true,
    "outDir": "build",
    "lib": ["ES2022", "DOM"],
