    },
    {
      "block_id": "imaging-fcnv",
      "ticks": 200000
    },
    {
      "block_id": "imaging-filter-scaler",
      "ticks": 200000
    },
    {
      "block_id": "imaging-resz",
      "ticks": 200000
    },
    {
      "block_id": "imaging-rzl2",
      "ticks": 200000
    },
    {
      "block_id": "imaging-tnr",
      "ticks": 200000
    },
    {
      "block_id": "rifp-io",
      "ticks": 5000
    }
  ]
