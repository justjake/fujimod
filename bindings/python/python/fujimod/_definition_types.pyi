from _fujimod_service_values import Codec

from ._variants import Sum
from .catalog.service import ServiceModes

class DefinitionFailure(Sum):
    class Json(DefinitionFailure):
        line: int
        column: int
        def __init__(self, line: int, column: int) -> None: ...

    class Schema(DefinitionFailure):
        schema: int
        def __init__(self, schema: int) -> None: ...

    class InvalidLayout(DefinitionFailure):
        code: int
        codec: Codec
        def __init__(self, code: int, codec: Codec) -> None: ...

    class EmptyIdentity(DefinitionFailure): ...
    class InvalidDigest(DefinitionFailure): ...
    class FirmwareMismatch(DefinitionFailure): ...
    class EmptyModes(DefinitionFailure): ...
    class InvalidMailbox(DefinitionFailure): ...
    class SourceCount(DefinitionFailure): ...
    class EmptyLabel(DefinitionFailure): ...

class ModeAvailability(Sum):
    class Modes(ModeAvailability):
        modes: ServiceModes
        def __init__(self, modes: ServiceModes) -> None: ...

    class Disabled(ModeAvailability): ...
    class Unreviewed(ModeAvailability): ...

class ModeTransition(Sum):
    class Keep(ModeTransition): ...

    class Set(ModeTransition):
        modes: ServiceModes
        def __init__(self, modes: ServiceModes) -> None: ...
