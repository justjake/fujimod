from collections.abc import Sequence
from os import PathLike
from typing import Literal, Protocol

class ScanoutSource(Protocol):
    def recording_frame(
        self, node: str, instance: int, diagnostic_hashes: bool, /
    ) -> tuple[bytes, str, int, int] | None: ...

class Frame:
    @staticmethod
    def rgb(width: int, height: int, data: bytes) -> Frame: ...
    @staticmethod
    def bgra(width: int, height: int, stride: int, data: bytes) -> Frame: ...
    @staticmethod
    def from_png(data: bytes) -> Frame: ...
    def png(self) -> bytes: ...
    def pixels(self) -> bytes: ...
    def save(self, path: str | PathLike[str]) -> str: ...
    def annotated(self, labels: Sequence[tuple[str, int]]) -> Frame: ...
    @property
    def sha256(self) -> str: ...
    @property
    def width(self) -> int: ...
    @property
    def height(self) -> int: ...
    @property
    def state(self) -> str: ...
    @property
    def instance(self) -> int | None: ...

class Recorder:
    def __init__(
        self, output: str | PathLike[str], *, fps: int = 30, video: bool = False
    ) -> None: ...
    def card_panel(self, snapshot: str | None = None) -> None: ...
    def card_formatting(self) -> None: ...
    def display_panel(
        self, frame: Frame | None = None, *, label: str = "", width: float = 0.6
    ) -> None: ...
    def animate(self, seconds: float) -> None: ...
    def frame(self, frame: Frame, seconds: float) -> None: ...
    def input(self, name: str, pressed: bool, seconds: float) -> None: ...
    def touch(
        self, phase: Literal["start", "move", "end"], x: float, y: float, seconds: float
    ) -> None: ...
    def still(self, frame: Frame, seconds: float) -> None: ...
    def screenshot(self, frame: Frame, name: str) -> str: ...
    def sample_scanout(
        self,
        source: ScanoutSource,
        seconds: float,
        *,
        instance: int | None = None,
        force: bool = False,
    ) -> bool: ...
    def finish(self) -> None: ...
    def metrics(self) -> str: ...
    @property
    def seconds(self) -> float: ...
    @property
    def fps(self) -> int: ...
    @property
    def sample_fps(self) -> int: ...
    @property
    def video(self) -> bool: ...
    @property
    def has_poster(self) -> bool: ...
    @property
    def idle_limit(self) -> float: ...
    @idle_limit.setter
    def idle_limit(self, value: float) -> None: ...
    @property
    def skipped_seconds(self) -> float: ...
    @property
    def frames(self) -> int: ...

def capture_scanout(
    source: ScanoutSource, instance: int | None = None, diagnostics: bool = True
) -> Frame | None: ...
def seconds_value(value: float) -> float: ...
def controls() -> str: ...
