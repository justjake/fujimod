{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "rootDir": "../..",
    "types": ["node", "emscripten"],
    "declaration": false
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.mts",
    "../python/tests/**/*.ts",
    "../python/scripts/**/*.ts"
  ],
  "exclude": ["tests/types.ts", "tests/usb.test.ts"]
}
