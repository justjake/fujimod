  "hardware": {
    "profiles": {
      "xh2s": {
        "dram_basis": "The stock bus-drain helpers split memory at 0x80000000; the first region ends there. Memory above it (0x80000000..0x98000000) is used by a debug-gated memory test at 0x306b1d4, so installed capacity is larger and unmeasured.",
        "limits": []
      }
    },
    "serial_attachments": [
      {
        "part_id": "power-controller",
        "controller_id": "spi8",
        "connection_id": "power-controller-bus",
        "select_connection_id": "power-controller-select"
      },
      {
        "part_id": "serial-command-16-read",
        "controller_id": "spi4",
        "connection_id": "serial-command-16-read-spi4-bus",
        "select_connection_id": "serial-command-16-read-spi4-select"
      },
      {
        "part_id": "serial-command-16",
        "controller_id": "spi5",
        "connection_id": "serial-command-16-spi5-bus",
        "select_connection_id": "serial-command-16-spi5-select"
      },
      {
        "part_id": "serial-command-8-mode2",
        "controller_id": "spi5",
        "connection_id": "serial-command-8-mode2-spi5-bus",
        "select_connection_id": "serial-command-8-mode2-spi5-select"
      },
      {
        "part_id": "bis-configuration",
        "controller_id": "spi7",
        "connection_id": "bis-configuration-spi7-bus",
        "select_connection_id": "bis-configuration-spi7-select"
      },
      {
        "part_id": "lsm6ds",
        "controller_id": "spi7",
        "connection_id": "lsm6ds-spi7-bus",
        "select_connection_id": "lsm6ds-spi7-select"
      }
    ],
    "thermal_connection_ids": [
      "thermal-0"
    ],
    "bus_drain": [
      {
        "address": 2147483648,
        "processor_ids": [
          "core0",
          "core1",
          "core2",
          "core3"
        ],
        "basis": "The stock firmware drains the bus with a discarded read of the end of its first memory region: helper 0x17f1794 (slot 1) and classifier 0x17f15b0 read 0x80000000, where X-T5 and X-S20 read 0x60000000 and X100VI 0x68000000."
      },
      {
        "address": 4294967296,
        "processor_ids": [
          "core0",
          "core1",
          "core2",
          "core3"
        ],
        "basis": "The stock firmware drains the second bus port with a discarded read at 0x100000000; helper 0x17f1794 names the port after 0x80000000 (D9)."
      },
      {
        "address": 6442450944,
        "processor_ids": [
          "core0",
          "core1",
          "core2",
          "core3"
        ],
        "basis": "The stock firmware drains the third bus port with a discarded read at 0x180000000; helper 0x17f1794 names the port after 0x100000000 (D9)."
      }
    ]
  },
