{
  "$schema": "https://fujimod.com/schemas/physical-controls.schema.json",
  "schema": 1,
  "id": "xa10-controls",
  "body_id": "xa10",
  "manual": {
    "url": "https://fujifilm-dsc.com/en/manual/x-a10/x-a10_omw_en_s_f.pdf",
    "title": "FUJIFILM X-A10 Owner’s Manual",
    "pages": [
      2, 3, 4, 13, 14, 21, 24, 28, 29, 32, 33, 35, 37, 38, 45, 55, 58, 60, 61, 62, 63, 71, 75, 80,
      89, 94, 105
    ]
  },
  "controls": {
    "battery_chamber_cover_latch": {
      "name": "Battery-chamber cover latch",
      "location": "bottom",
      "manual_page": 14,
      "short_name": "COVER",
      "assignable": false,
      "pushable": false,
      "default_function": "Slide to open the battery-chamber cover.",
      "mechanical": false,
      "behavior": {
        "kind": "lever"
      }
    },
    "battery_latch": {
      "name": "Battery latch",
      "location": "bottom",
      "manual_page": 14,
      "short_name": "BATTERY",
      "assignable": false,
      "pushable": false,
      "default_function": "Hold the battery in place; press to the side to release the battery for removal.",
      "mechanical": false,
      "behavior": {
        "kind": "lever"
      }
    },
    "disp_back_button": {
      "name": "DISP (display)/BACK button",
      "location": "rear",
      "manual_page": 24,
      "face": "DISP/BACK",
      "assignable": false,
      "pushable": true,
      "default_function": "Cycle through display modes in shooting or playback.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "flash_pop_up_switch": {
      "name": "Flash pop-up switch",
      "location": "right",
      "manual_page": 71,
      "icon": "flash",
      "assignable": false,
      "pushable": false,
      "default_function": "Slide to raise the built-in flash; lowering the flash turns it off.",
      "mechanical": false,
      "behavior": {
        "kind": "switch"
      }
    },
    "fn_button": {
      "name": "Fn (function) button",
      "location": "top",
      "manual_page": 105,
      "face": "Fn",
      "assignable": true,
      "pushable": true,
      "default_function": "ISO (factory default); its role can be assigned to another listed function or set to NONE.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "lens_release_button": {
      "name": "Lens release button",
      "location": "front",
      "manual_page": 13,
      "short_name": "LENS",
      "assignable": false,
      "pushable": true,
      "default_function": "Release the attached lens from the camera mount.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "main_command_dial": {
      "name": "Main command dial",
      "location": "top",
      "manual_page": 4,
      "short_name": "MAIN DIAL",
      "assignable": false,
      "pushable": false,
      "default_function": "Rotate to adjust exposure compensation in P, S, and A modes or shutter speed in M mode; choose quick-menu options; advance frames in playback.",
      "mechanical": false,
      "behavior": {
        "kind": "dial",
        "motion": {
          "kind": "steps"
        }
      }
    },
    "menu_ok_button": {
      "name": "MENU/OK button",
      "location": "rear",
      "manual_page": 3,
      "face": "MENU/OK",
      "assignable": false,
      "pushable": true,
      "default_function": "Open menus and confirm selections; press and hold to lock or unlock the selector and Q button during shooting.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "mode_dial": {
      "name": "Mode dial",
      "location": "top",
      "manual_page": 38,
      "short_name": "MODE",
      "assignable": false,
      "pushable": false,
      "positions": [
        {
          "id": "P",
          "label": "P"
        },
        {
          "id": "S",
          "label": "S"
        },
        {
          "id": "A",
          "label": "A"
        },
        {
          "id": "M",
          "label": "M"
        },
        {
          "id": "C",
          "label": "C"
        },
        {
          "id": "S_2",
          "label": "S"
        },
        {
          "id": "Adv.",
          "label": "Adv."
        },
        {
          "id": "SP",
          "label": "SP"
        },
        {
          "id": "portrait_enhancer",
          "label": "icon",
          "description": "Choose for a smooth skin effect when shooting portraits."
        },
        {
          "id": "landscape",
          "label": "icon",
          "description": "Choose for daylight shots of buildings and landscapes."
        },
        {
          "id": "sport",
          "label": "icon",
          "description": "Choose when photographing moving subjects."
        },
        {
          "id": "night",
          "label": "icon",
          "description": "Choose for poorly lit twilight or night scenes."
        }
      ],
      "default_function": "Select the shooting mode.",
      "mechanical": false,
      "behavior": {
        "kind": "dial",
        "motion": {
          "kind": "positions",
          "positions": [
            {
              "id": "P"
            },
            {
              "id": "S"
            },
            {
              "id": "A"
            },
            {
              "id": "M"
            },
            {
              "id": "C"
            },
            {
              "id": "S_2"
            },
            {
              "id": "Adv."
            },
            {
              "id": "SP"
            },
            {
              "id": "portrait_enhancer"
            },
            {
              "id": "landscape"
            },
            {
              "id": "sport"
            },
            {
              "id": "night"
            }
          ]
        }
      }
    },
    "movie_recording_button": {
      "name": "Movie recording button",
      "location": "rear",
      "manual_page": 33,
      "icon": "record",
      "assignable": false,
      "pushable": true,
      "default_function": "Start or stop movie recording.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "on_off_switch": {
      "name": "ON/OFF switch",
      "location": "top",
      "manual_page": 21,
      "face": "ON/OFF",
      "assignable": false,
      "pushable": false,
      "positions": [
        {
          "id": "ON",
          "label": "ON"
        },
        {
          "id": "OFF",
          "label": "OFF"
        }
      ],
      "default_function": "Turn the camera on or off.",
      "mechanical": false,
      "behavior": {
        "kind": "switch",
        "positions": [
          {
            "id": "ON"
          },
          {
            "id": "OFF"
          }
        ]
      }
    },
    "playback_button": {
      "name": "Playback button",
      "location": "rear",
      "manual_page": 29,
      "icon": "playback",
      "assignable": false,
      "pushable": true,
      "default_function": "Start playback; press the shutter button halfway to return to shooting mode.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "q_button": {
      "name": "Q (quick menu) button",
      "location": "rear",
      "manual_page": 35,
      "face": "Q",
      "assignable": false,
      "pushable": true,
      "default_function": "Display the quick menu in shooting mode; access RAW conversion in playback mode.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "selector": {
      "name": "Selector",
      "location": "rear",
      "manual_page": 3,
      "short_name": "SELECTOR",
      "assignable": false,
      "pushable": true,
      "default_function": "Move the cursor up, down, left, or right; up selects AF in shooting or delete in playback, left selects the self-timer, down selects burst shooting, and right selects white balance; also navigate playback.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "shutter_button": {
      "name": "Shutter button",
      "location": "top",
      "manual_page": 28,
      "short_name": "SHUTTER",
      "assignable": false,
      "pushable": true,
      "positions": [
        {
          "id": "half-press",
          "label": "half-press"
        },
        {
          "id": "full press",
          "label": "full press"
        }
      ],
      "default_function": "Press halfway to focus and lock focus and exposure; press fully to take a picture.",
      "mechanical": false,
      "behavior": {
        "kind": "shutter",
        "stages": {
          "full_press": null,
          "half_press": null
        }
      }
    },
    "sub_command_dial": {
      "name": "Sub-command dial",
      "location": "top",
      "manual_page": 4,
      "short_name": "SUB DIAL",
      "assignable": false,
      "pushable": true,
      "default_function": "Rotate to adjust program shift in P, shutter speed in S, and aperture in A or M; zoom in or out in playback. Press to zoom on the selected focus point, choose MF ASSIST in manual focus, or release the shutter for a self-portrait when the monitor is rotated 180°.",
      "mechanical": false,
      "behavior": {
        "kind": "dial",
        "motion": {
          "kind": "steps"
        }
      }
    }
  }
}
