{
  "$schema": "https://fujimod.com/schemas/physical-controls.schema.json",
  "schema": 1,
  "id": "xm5-controls",
  "body_id": "xm5",
  "manual": {
    "url": "https://app.fujifilm-dsc.com/en/manual/x-m5/x-m5_manual_en_s_f.pdf",
    "title": "FUJIFILM X-M5 Owner's Manual (BL00005372-202 EN)",
    "pages": [
      2, 3, 5, 6, 7, 9, 10, 17, 21, 24, 25, 26, 27, 28, 29, 33, 35, 36, 41, 49, 50, 53, 56, 57, 58,
      113, 236, 265, 320, 322, 323, 331, 332, 343, 349
    ]
  },
  "boot": {
    "sd": {
      "usb": false,
      "hold": [
        {
          "id": "quick_menu_button"
        },
        {
          "id": "front_command_dial.press"
        }
      ]
    },
    "firmware_update": {
      "hold": [
        {
          "id": "disp_back_bluetooth_button"
        }
      ]
    }
  },
  "controls": {
    "ael_afl_button": {
      "name": "AEL (exposure lock)/AFL (focus lock) button",
      "location": "rear",
      "manual_page": 113,
      "face": "AEL/AFL",
      "assignable": true,
      "pushable": true,
      "default_function": "Lock focus and exposure by default; its role can be assigned through FUNCTION (Fn) SETTING.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "battery_chamber_cover_latch": {
      "name": "Battery-chamber cover latch",
      "location": "bottom",
      "manual_page": 35,
      "short_name": "COVER",
      "assignable": false,
      "pushable": false,
      "default_function": "Slide to open or close the battery-chamber cover.",
      "mechanical": false,
      "behavior": {
        "kind": "lever"
      }
    },
    "battery_latch": {
      "name": "Battery latch",
      "location": "bottom",
