    "playback_button": {
      "name": "Playback button",
      "location": "rear",
      "manual_page": 3,
      "icon": "playback",
      "assignable": false,
      "pushable": true,
      "default_function": "Starts playback during shooting.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "power_switch": {
      "name": "ON/OFF switch",
      "location": "top",
      "manual_page": 2,
      "face": "ON/OFF",
      "assignable": false,
      "pushable": false,
      "positions": [
        {
          "id": "ON",
          "label": "ON"
        },
        {
          "id": "OFF",
          "label": "OFF"
        }
      ],
      "default_function": "Turns the camera on or off.",
      "mechanical": false,
      "behavior": {
        "kind": "switch",
        "positions": [
          {
            "id": "ON"
          },
          {
            "id": "OFF"
          }
        ]
      }
