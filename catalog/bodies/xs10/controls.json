    "movie_recording_button": {
      "name": "Movie recording button",
      "location": "top",
      "manual_page": 2,
      "icon": "record",
      "assignable": true,
      "pushable": true,
      "default_function": "MOVIE RECORDING RELEASE",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
