{
  "$schema": "https://fujimod.com/schemas/physical-controls.schema.json",
  "schema": 1,
  "id": "xs10-controls",
  "body_id": "xs10",
  "manual": {
    "url": "https://app.fujifilm-dsc.com/en/manual/x-s10/x-s10_omw_en_s_f.pdf",
    "title": "FUJIFILM X-S10 Owner's Manual",
    "pages": [
      2, 3, 4, 5, 6, 7, 9, 16, 19, 21, 22, 23, 24, 25, 29, 35, 43, 44, 45, 48, 69, 88, 101, 222,
      223, 227, 251, 252, 254
    ]
  },
  "boot": {
    "sd": {
      "usb": false,
      "hold": [
        {
          "id": "quick_menu_button"
        },
        {
          "id": "movie_recording_button"
        }
      ]
    },
    "firmware_update": {
      "hold": [
        {
          "id": "display_back_button"
        }
      ]
    }
  },
  "controls": {
    "ae_lock_button": {
      "name": "AEL (exposure lock) button",
      "location": "rear",
      "manual_page": 3,
      "face": "AE-L",
      "assignable": true,
      "pushable": true,
      "default_function": "AE LOCK ONLY",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "af_on_button": {
      "name": "AFON button",
      "location": "rear",
      "manual_page": 3,
      "face": "AFON",
      "assignable": true,
      "pushable": true,
      "default_function": "AF-ON",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "battery_chamber_cover_latch": {
      "name": "Battery-chamber cover latch",
      "location": "bottom",
      "manual_page": 30,
      "short_name": "COVER",
      "assignable": false,
      "pushable": false,
      "default_function": "Slide to open the battery-chamber cover.",
      "mechanical": false,
      "behavior": {
        "kind": "lever"
      }
    },
    "battery_latch": {
      "name": "Battery latch",
      "location": "bottom",
      "manual_page": 31,
      "short_name": "BATTERY",
      "assignable": false,
      "pushable": true,
      "default_function": "Press to the side to release the battery for removal.",
      "mechanical": false,
      "behavior": {
        "kind": "lever"
      }
    },
    "diopter_adjustment_control": {
      "name": "Diopter adjustment control",
      "location": "rear",
      "manual_page": 3,
      "short_name": "DIOPTER",
      "assignable": false,
      "pushable": false,
      "default_function": "Adjusts viewfinder focus until the display is sharp.",
      "mechanical": false,
      "behavior": {
        "kind": "dial",
        "motion": {
          "kind": "steps"
        }
      }
    },
    "display_back_button": {
      "name": "DISP (display)/BACK button",
      "location": "rear",
      "manual_page": 3,
      "face": "DISP/BACK",
      "assignable": false,
      "pushable": true,
      "default_function": "Controls the indicators shown in the viewfinder and LCD monitor; serves as BACK in menus.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "drive_delete_button": {
      "name": "Drive button / Delete button (playback mode)",
      "location": "rear",
      "manual_page": 3,
      "face": "DRIVE",
      "assignable": false,
      "pushable": true,
      "default_function": "Displays the drive-mode menu during shooting; deletes pictures in playback mode.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "flash_pop_up_lever": {
      "name": "Flash pop-up lever",
      "location": "top",
      "manual_page": 2,
      "icon": "flash",
      "assignable": false,
      "pushable": false,
      "default_function": "Slide the lever to raise the built-in flash.",
      "mechanical": false,
      "behavior": {
        "kind": "lever"
      }
    },
    "focus_stick": {
      "name": "Focus stick (focus lever)",
      "location": "rear",
      "manual_page": 3,
      "short_name": "FOCUS",
      "assignable": true,
      "pushable": true,
      "default_function": "Tilt or press to select the focus area and navigate menus; the center and directional functions can be configured with FOCUS LEVER SETTING.",
