      "name": "Front command dial",
      "location": "front",
      "manual_page": 2,
      "short_name": "FRONT DIAL",
      "assignable": false,
      "pushable": false,
      "default_function": "Roles vary by shooting mode. It adjusts program shift, aperture, or shutter speed; in menus it selects tabs or pages, in the quick menu it selects items, and in playback it views other pictures.",
      "mechanical": false,
      "behavior": {
        "kind": "dial",
        "motion": {
          "kind": "steps"
        }
      }
    },
    "function_button": {
      "name": "Fn button",
      "location": "rear",
      "manual_page": 3,
      "face": "Fn",
      "assignable": true,
      "pushable": true,
      "default_function": "WHITE BALANCE",
