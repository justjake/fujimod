      "behavior": {
        "kind": "shutter",
        "stages": {
          "full_press": null,
          "half_press": null
        }
      }
    },
    "touch_screen": {
      "name": "Touch screen",
      "location": "rear",
      "manual_page": 3,
      "assignable": true,
      "pushable": false,
      "default_function": "Supports touch photography, focus-area selection, function selection, movie optimized control, and full-frame playback operations; touch-function flick gestures can be assigned roles.",
