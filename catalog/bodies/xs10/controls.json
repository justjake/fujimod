      "name": "Q (quick menu) button",
      "location": "top",
      "manual_page": 2,
      "face": "Q",
      "assignable": true,
      "pushable": true,
      "default_function": "QUICK MENU",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "rear_command_dial": {
      "name": "Rear command dial",
      "location": "top",
      "manual_page": 2,
      "short_name": "REAR DIAL",
      "assignable": false,
      "pushable": false,
      "default_function": "Roles vary by shooting mode. It adjusts exposure compensation or shutter speed; in menus it highlights items, in the quick menu it adjusts settings, and in playback it zooms in or out.",
      "mechanical": false,
      "behavior": {
        "kind": "dial",
        "motion": {
          "kind": "steps"
        }
      }
    },
    "shutter_button": {
      "name": "Shutter button",
      "location": "top",
      "manual_page": 2,
      "short_name": "SHUTTER",
      "assignable": false,
      "pushable": true,
      "default_function": "Half-press to focus and lock focus and exposure subject to the SHUTTER AF and SHUTTER AE settings; press fully to take a picture or start or stop movie recording in movie mode.",
