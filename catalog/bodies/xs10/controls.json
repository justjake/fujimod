      "name": "Fn (function) dial",
      "location": "top",
      "manual_page": 2,
      "short_name": "FN",
      "assignable": true,
      "pushable": false,
      "default_function": "At the DEFAULT setting, selects a filter in FILTER mode and film simulation in other mode-dial positions.",
      "mechanical": false,
      "behavior": {
        "kind": "dial",
        "motion": {
          "kind": "steps"
        }
      }
    },
    "iso_button": {
      "name": "ISO button",
      "location": "top",
      "manual_page": 2,
      "face": "ISO",
      "assignable": true,
      "pushable": true,
      "default_function": "ISO",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "lens_release_button": {
      "name": "Lens release button",
      "location": "front",
      "manual_page": 2,
      "short_name": "LENS",
      "assignable": false,
      "pushable": true,
      "default_function": "Press while rotating the lens to remove it.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "menu_ok_button": {
      "name": "MENU/OK button",
      "location": "rear",
      "manual_page": 3,
      "face": "MENU/OK",
      "assignable": false,
      "pushable": true,
      "default_function": "Displays menus and confirms selections.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
