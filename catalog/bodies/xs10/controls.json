      "name": "Mode dial",
      "location": "top",
      "manual_page": 2,
      "short_name": "MODE",
      "assignable": false,
      "pushable": false,
      "positions": [
        {
          "id": "AUTO",
          "label": "AUTO"
        },
        {
          "id": "P",
          "label": "P"
        },
        {
          "id": "S",
          "label": "S"
        },
        {
          "id": "A",
          "label": "A"
        },
        {
          "id": "M",
          "label": "M"
        },
        {
          "id": "C1",
          "label": "C1"
        },
        {
          "id": "C2",
          "label": "C2"
        },
        {
          "id": "C3",
          "label": "C3"
        },
        {
          "id": "C4",
          "label": "C4"
        },
        {
          "id": "F",
          "label": "F"
        },
        {
          "id": "FILTER",
          "label": "FILTER"
        },
        {
          "id": "SP",
          "label": "SP"
        }
      ],
      "default_function": "Selects the shooting mode.",
      "mechanical": false,
      "behavior": {
        "kind": "dial",
        "motion": {
          "kind": "positions",
          "positions": [
            {
              "id": "AUTO"
            },
            {
              "id": "P"
            },
            {
              "id": "S"
            },
            {
              "id": "A"
            },
            {
              "id": "M"
            },
            {
              "id": "C1"
            },
            {
              "id": "C2"
            },
            {
              "id": "C3"
            },
            {
              "id": "C4"
            },
            {
              "id": "F"
            },
            {
              "id": "FILTER"
            },
            {
              "id": "SP"
            }
          ]
        }
      }
