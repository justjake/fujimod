  "ladders": [
    {
      "wire": {
        "kind": "adc",
        "channel": 6
      },
      "levels": 4096,
      "basis": "The firmware reads this ADC channel at 12-bit resolution (the refresh 0x140af08 caches it at 0x207aae4). Bands come from the firmware's factory key-band table; a body with its own valid configuration store reads its own bands. No released level is established: it is this channel's idle sample, a property of the body.",
      "rungs": [
        {
          "control_id": "menu_ok_button",
          "band_low": 0,
          "band_high": 782,
          "sample": 391,
          "basis": "Band 0..782, derived from the firmware's factory key-band table (scanner row 30, physical code 0xd, UI event KEY_OK 1); no other control on this wire accepts it. The sample is the band midpoint."
        },
        {
          "control_id": "disp_back_button",
          "band_low": 2637,
          "band_high": 3102,
          "sample": 2869,
          "basis": "Band 2637..3102, derived from the firmware's factory key-band table (scanner row 28, physical code 0xf, UI event KEY_DISP_BACK 9); no other control on this wire accepts it. The sample is the band midpoint."
        }
      ]
    },
    {
      "wire": {
        "kind": "adc",
        "channel": 13
      },
      "levels": 4096,
      "basis": "The firmware reads this ADC channel at 12-bit resolution (the refresh 0x140af08 caches it at 0x207aaf2). Bands come from the firmware's factory key-band table; a body with its own valid configuration store reads its own bands. No released level is established: it is this channel's idle sample, a property of the body.",
      "rungs": [
        {
          "control_id": "selector_up_button",
          "band_low": 1448,
          "band_high": 1688,
          "sample": 1568,
          "basis": "Band 1448..1688, derived from the firmware's factory key-band table (scanner row 31, physical code 0x15, UI event KEY_UP 2); no other control on this wire accepts it. The sample is the band midpoint."
        },
        {
          "control_id": "selector_right_button",
          "band_low": 1930,
          "band_high": 2219,
          "sample": 2074,
          "basis": "Band 1930..2219, derived from the firmware's factory key-band table (scanner row 34, physical code 0x18, UI event KEY_RIGHT 5); no other control on this wire accepts it. The sample is the band midpoint."
        },
        {
          "control_id": "selector_left_button",
          "band_low": 2606,
          "band_high": 3041,
          "sample": 2823,
          "basis": "Band 2606..3041, derived from the firmware's factory key-band table (scanner row 33, physical code 0x17, UI event KEY_LEFT 4); no other control on this wire accepts it. The sample is the band midpoint."
        },
        {
          "control_id": "selector_down_button",
          "band_low": 3042,
          "band_high": 3719,
          "sample": 3380,
          "basis": "Band 3042..3719, derived from the firmware's factory key-band table (scanner row 32, physical code 0x16, UI event KEY_DOWN 3); no other control on this wire accepts it. The sample is the band midpoint."
        }
      ]
    }
  ]
