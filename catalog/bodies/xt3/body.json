{
  "$schema": "https://fujimod.com/schemas/body.schema.json",
  "schema": 1,
  "id": "xt3",
  "soc_id": "xp4",
  "dram_bytes": 1073741824,
  "hardware": {
    "profiles": {
      "xt3-discovery": {
        "dram_basis": "1 GiB. The guarded JIG RAM capture (CPU-virtual 0x0..0x40000000, sha256 2773ac81bc202c2a02888873914382d75ead20c5e013a33889aded643a6bdd2b) is populated with real content through the top of the window (strings and structures up to at least 0x3e1b6b04), so the earlier declared 512 MiB was too small."
      }
    },
    "serial_attachments": [
      {
        "part_id": "xt3-power-registers",
        "controller_id": "spi1",
        "connection_id": "xt3-power-registers-bus",
        "select_connection_id": "xt3-power-registers-select"
      }
    ],
    "thermal_connection_ids": [
      "thermal-0",
      "thermal-8",
      "thermal-10"
    ],
    "xp4_lens_mount": {
      "controller_id": "spi0",
      "detect_connection_id": "xt3-lens-detect",
      "sense_connection_ids": [
        "xt3-lens-sense-0",
        "xt3-lens-sense-1",
        "xt3-lens-sense-2",
        "xt3-lens-sense-3"
      ],
      "supply_connection_ids": [
        "xt3-lens-supply-0",
        "xt3-lens-supply-1"
      ],
      "ready_connection_id": "xt3-lens-ready",
      "lens_part_id": "xf16-80-lens",
      "mounted": true,
      "miso_high": true
    }
  },
  "storage_slots": [
    {
      "id": "sd_card",
      "label": "1"
    },
    {
      "id": "sd_card_2",
      "label": "2"
    }
  ],
  "connections": [
    {
      "id": "flash-storage",
      "kind": "control"
    },
    {
      "id": "xt3-power-registers-bus",
      "kind": "power-control"
    },
    {
      "id": "xt3-power-registers-select",
      "kind": "power-control",
      "signals": [
        {
          "kind": "gpio",
          "port": 12,
          "pin": 5,
          "active_level": true
        }
      ]
    },
    {
      "id": "thermal-0",
      "kind": "control",
      "signals": [
        {
          "kind": "adc",
          "channel": 0
        }
      ]
    },
    {
      "id": "thermal-8",
      "kind": "control",
      "signals": [
        {
          "kind": "adc",
          "channel": 8
        }
      ]
    },
    {
      "id": "thermal-10",
      "kind": "control",
      "signals": [
        {
          "kind": "adc",
          "channel": 10
        }
      ]
    },
    {
      "id": "xt3-key-ladder-3",
      "kind": "control",
      "signals": [
        {
          "kind": "adc",
          "channel": 3
        }
      ]
    },
    {
      "id": "xt3-key-ladder-9",
      "kind": "control",
      "signals": [
        {
          "kind": "adc",
          "channel": 9
        }
      ]
    },
    {
      "id": "xt3-key-ladder-11",
      "kind": "control",
      "signals": [
        {
          "kind": "adc",
          "channel": 11
        }
      ]
    },
    {
      "id": "xt3-shutter-s1",
      "kind": "control",
      "signals": [
        {
          "kind": "gpio",
          "port": 0,
          "pin": 0,
          "active_level": false
        },
        {
          "kind": "interrupt",
          "controller_id": "gic-distributor",
          "line": 167
        }
      ]
    },
    {
      "id": "xt3-shutter-s2",
      "kind": "control",
      "signals": [
        {
          "kind": "gpio",
          "port": 0,
          "pin": 1,
          "active_level": false
        },
        {
          "kind": "interrupt",
          "controller_id": "gic-distributor",
          "line": 168
        }
      ]
    },
    {
      "id": "xt3-fn1-button",
      "kind": "control",
      "signals": [
        {
          "kind": "gpio",
          "port": 0,
          "pin": 14,
          "active_level": false
        }
      ]
    },
    {
      "id": "xt3-fn2-button",
      "kind": "control",
      "signals": [
        {
          "kind": "gpio",
          "port": 2,
          "pin": 13,
          "active_level": false
        }
      ]
    },
    {
      "id": "xt3-rear-dial-press",
      "kind": "control",
      "signals": [
        {
          "kind": "gpio",
          "port": 0,
          "pin": 13,
          "active_level": false
        }
      ]
    },
    {
      "id": "xt3-rear-dial-count",
      "kind": "control",
      "signals": [
        {
          "kind": "countdown_timer",
          "block_id": "countdown-timer-control",
          "channel": 2,
          "rest_phase": 0
        }
      ]
    },
    {
      "id": "xt3-front-dial-count",
      "kind": "control",
      "signals": [
        {
          "kind": "countdown_timer",
          "block_id": "countdown-timer-control",
          "channel": 4,
          "rest_phase": 0
        }
      ]
    },
    {
      "id": "xt3-usb",
      "kind": "usb",
      "signals": [
        {
          "kind": "gpio",
          "port": 15,
          "pin": 15,
          "active_level": true
        }
      ],
      "evidence": {
        "kind": "stand-in"
      }
    },
    {
      "id": "xt3-lens-detect",
      "kind": "lens",
      "signals": [
        {
          "kind": "gpio",
          "port": 0,
          "pin": 11,
          "active_level": false
        }
      ]
    },
    {
      "id": "xt3-lens-supply-0",
      "kind": "lens",
      "signals": [
        {
          "kind": "gpio",
          "port": 1,
          "pin": 12,
          "active_level": true
        }
      ]
    },
    {
      "id": "xt3-lens-supply-1",
      "kind": "lens",
      "signals": [
        {
          "kind": "gpio",
          "port": 1,
          "pin": 13,
          "active_level": true
        }
      ]
    },
    {
      "id": "xt3-lens-sense-0",
      "kind": "lens",
      "signals": [
        {
          "kind": "gpio",
          "port": 11,
          "pin": 0,
          "active_level": true
        }
      ]
    },
    {
      "id": "xt3-lens-sense-1",
      "kind": "lens",
      "signals": [
        {
          "kind": "gpio",
          "port": 11,
          "pin": 1,
          "active_level": false
        }
      ]
    },
    {
      "id": "xt3-lens-sense-2",
      "kind": "lens",
      "signals": [
        {
          "kind": "gpio",
          "port": 11,
          "pin": 2,
          "active_level": true
        }
      ]
    },
    {
      "id": "xt3-lens-sense-3",
      "kind": "lens",
      "signals": [
        {
          "kind": "gpio",
          "port": 15,
          "pin": 0,
          "active_level": true
        }
      ]
    },
    {
      "id": "xt3-lens-ready",
      "kind": "lens",
      "signals": [
        {
          "kind": "gpio",
          "port": 15,
          "pin": 1,
          "active_level": false
        },
        {
          "kind": "interrupt",
          "controller_id": "gic-distributor",
          "line": 55
        }
      ]
    }
  ],
  "parts": [
    "xt3-serial-nor",
    "xt3-power-registers",
    "xt3-image-sensor",
    "xf16-80-lens"
  ],
  "wiring": [
    {
      "source_id": "serial-flash",
      "target_id": "xt3-serial-nor",
      "signal": "storage"
    },
    {
      "source_id": "spi1",
      "target_id": "xt3-power-registers",
      "signal": "serial_data"
    },
    {
      "source_id": "xt3-image-sensor",
      "target_id": "imaging-receiver",
      "signal": "image_data"
    },
    {
      "source_id": "spi0",
      "target_id": "xf16-80-lens",
      "signal": "serial_data"
    }
  ]
}
