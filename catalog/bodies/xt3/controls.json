    "metering_dial": {
      "name": "Metering dial",
      "location": "top",
      "manual_page": 80,
      "short_name": "METER",
      "assignable": false,
      "pushable": false,
      "positions": [
        {
          "id": "spot",
          "label": "icon",
          "description": "The camera meters lighting conditions in an area at the center of the frame equivalent to 2% of the total."
        },
        {
          "id": "center_weighted",
          "label": "icon",
          "description": "The camera meters the entire frame but assigns the greatest weight to the area at the center."
        },
        {
          "id": "multi",
          "label": "icon",
          "description": "The camera instantly determines exposure based on an analysis of composition, color, and brightness distribution. Recommended in most situations."
        },
        {
          "id": "average",
          "label": "icon",
          "description": "Exposure is set to the average for the entire frame. Provides consistent exposure across multiple shots with the same lighting, and is particularly effective for landscapes and portraits of subjects dressed in black or white."
        }
      ],
      "default_function": "Choose how the camera meters exposure.",
      "mechanical": false,
      "behavior": {
        "kind": "dial",
        "motion": {
          "kind": "positions",
