{
  "$schema": "https://fujimod.com/schemas/physical-controls.schema.json",
  "schema": 1,
  "id": "xa7-controls",
  "body_id": "xa7",
  "manual": {
    "url": "https://fujifilm-dsc.com/en/manual/x-a7/x-a7_omw_en_s_f.pdf",
    "title": "FUJIFILM X-A7 Owner’s Manual",
    "pages": [
      2, 3, 4, 5, 6, 7, 9, 10, 11, 14, 15, 18, 21, 22, 24, 28, 35, 36, 37, 40, 88, 131, 162, 165,
      178, 179
    ]
  },
  "controls": {
    "battery_chamber_cover_latch": {
      "name": "Battery-chamber cover latch",
      "location": "bottom",
      "manual_page": 22,
      "short_name": "COVER",
      "assignable": false,
      "pushable": false,
      "default_function": "Slides to open the battery-chamber cover.",
      "mechanical": false,
      "behavior": {
        "kind": "lever"
      }
    },
    "battery_latch": {
      "name": "Battery latch",
      "location": "bottom",
      "manual_page": 24,
      "short_name": "BATTERY",
      "assignable": false,
      "pushable": false,
      "default_function": "Moves to the side to release the battery for removal.",
      "mechanical": false,
      "behavior": {
        "kind": "lever"
      }
    },
    "disp_back_button": {
      "name": "DISP (display)/BACK button",
      "location": "rear",
      "manual_page": 11,
      "face": "DISP/BACK",
      "assignable": false,
      "pushable": true,
      "default_function": "Cycles display modes and exits menus to the shooting display.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "drive_delete_button": {
      "name": "DRIVE button / Delete button (playback mode)",
      "location": "rear",
      "manual_page": 5,
      "face": "DRIVE",
      "assignable": false,
      "pushable": true,
      "default_function": "Opens drive-mode options while shooting and deletes the selected picture in playback mode.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "flash_pop_up_switch": {
      "name": "Flash pop-up switch",
      "location": "left",
      "manual_page": 88,
      "icon": "flash",
      "assignable": false,
      "pushable": false,
      "default_function": "Raises the built-in flash.",
      "mechanical": false,
      "behavior": {
        "kind": "switch"
      }
    },
    "fn1_button": {
      "name": "Fn1 button",
      "location": "top",
      "manual_page": 178,
      "face": "Fn1",
      "assignable": true,
      "pushable": true,
      "default_function": "Starts and stops movie recording (MOVIE RECORDING RELEASE).",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "focus_stick": {
      "name": "Focus stick (focus lever)",
      "location": "rear",
      "manual_page": 5,
      "short_name": "FOCUS",
      "assignable": true,
      "pushable": true,
      "default_function": "Selects the focus area and navigates menus; its role can be changed with FOCUS LEVER SETTING.",
      "mechanical": false,
      "behavior": {
        "kind": "pad",
        "directions": {
          "up": null,
          "down": null,
          "left": null,
          "right": null
        }
      }
    },
    "front_command_dial": {
      "name": "Front command dial",
      "location": "top",
      "manual_page": 6,
      "short_name": "FRONT DIAL",
      "assignable": false,
      "pushable": false,
      "default_function": "Adjusts program shift, aperture, or shutter speed while shooting; selects menu tabs or pages through menus; adjusts Quick Menu settings; and views other pictures during playback.",
      "mechanical": false,
      "behavior": {
        "kind": "dial",
        "motion": {
          "kind": "steps"
        }
      }
    },
    "lens_release_button": {
      "name": "Lens release button",
      "location": "front",
      "manual_page": 21,
      "short_name": "LENS",
      "assignable": false,
      "pushable": true,
      "default_function": "Releases the lens for removal.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "menu_ok_button": {
      "name": "MENU/OK button",
      "location": "rear",
      "manual_page": 14,
      "face": "MENU/OK",
      "assignable": false,
      "pushable": true,
      "default_function": "Displays menus and confirms selections.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "mode_dial": {
      "name": "Mode dial",
      "location": "top",
      "manual_page": 4,
      "short_name": "MODE",
      "assignable": false,
      "pushable": false,
      "positions": [
        {
          "id": "SR+",
          "label": "SR+"
        },
        {
          "id": "P",
          "label": "P"
        },
        {
          "id": "S",
          "label": "S"
        },
        {
          "id": "A",
          "label": "A"
        },
        {
          "id": "M",
          "label": "M"
        },
        {
          "id": "panorama",
          "label": "icon",
          "description": "Follow an on-screen guide to create a panorama."
        },
        {
          "id": "SP",
          "label": "SP"
        },
        {
          "id": "portrait_enhancer",
          "label": "icon",
          "description": "Choose for a smooth skin effect when shooting portraits."
        },
        {
          "id": "landscape",
          "label": "icon",
          "description": "Choose for daylight shots of buildings and landscapes."
        },
        {
          "id": "sport",
          "label": "icon",
          "description": "Choose when photographing moving subjects."
        },
        {
          "id": "night",
          "label": "icon",
          "description": "Choose for poorly lit twilight or night scenes."
        },
        {
          "id": "Adv.",
          "label": "Adv."
        }
      ],
      "default_function": "Selects the shooting mode; SP opens the Scene Position choices h/M/N/O.",
      "mechanical": false,
      "behavior": {
        "kind": "dial",
        "motion": {
          "kind": "positions",
          "positions": [
            {
              "id": "SR+"
            },
            {
              "id": "P"
            },
            {
              "id": "S"
            },
            {
              "id": "A"
            },
            {
              "id": "M"
            },
            {
              "id": "panorama"
            },
            {
              "id": "SP"
            },
            {
              "id": "portrait_enhancer"
            },
            {
              "id": "landscape"
            },
            {
              "id": "sport"
            },
            {
              "id": "night"
            },
            {
              "id": "Adv."
            }
          ]
        }
      }
    },
    "on_off_button": {
      "name": "ON/OFF button",
      "location": "top",
      "manual_page": 28,
      "face": "ON/OFF",
      "assignable": false,
      "pushable": true,
      "default_function": "Turns the camera on and off.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "playback_button": {
      "name": "Playback button",
      "location": "rear",
      "manual_page": 36,
      "icon": "playback",
      "assignable": false,
      "pushable": true,
      "default_function": "Starts playback during shooting.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "rear_command_dial": {
      "name": "Rear command dial",
      "location": "top",
      "manual_page": 6,
      "short_name": "REAR DIAL",
      "assignable": false,
      "pushable": false,
      "default_function": "Chooses shutter speed and exposure compensation while shooting, highlights menu items, adjusts Quick Menu settings, and zooms during playback.",
      "mechanical": false,
      "behavior": {
        "kind": "dial",
        "motion": {
          "kind": "steps"
        }
      }
    },
    "shutter_button": {
      "name": "Shutter button",
      "location": "top",
      "manual_page": 35,
      "short_name": "SHUTTER",
      "assignable": false,
      "pushable": true,
      "positions": [
        {
          "id": "half-press",
          "label": "half-press"
        },
        {
          "id": "full press",
          "label": "full press"
        }
      ],
      "default_function": "Half-presses to focus and lock focus and exposure; full-presses to take a photograph. In movie mode, starts and stops recording.",
      "mechanical": false,
      "behavior": {
        "kind": "shutter",
        "stages": {
          "full_press": null,
          "half_press": null
        }
      }
    },
    "touchscreen": {
      "name": "Touch screen",
      "location": "rear",
      "manual_page": 15,
      "assignable": true,
      "pushable": false,
      "default_function": "Provides touch controls for shooting, focus selection, menus, and playback; T.B. Fn1 and T.B. Fn2 provide assigned functions.",
      "mechanical": false,
      "behavior": {
        "kind": "touch"
      }
    }
  }
}
