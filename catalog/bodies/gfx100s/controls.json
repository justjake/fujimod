{
  "$schema": "https://fujimod.com/schemas/physical-controls.schema.json",
  "schema": 1,
  "id": "gfx100s-controls",
  "body_id": "gfx100s",
  "manual": {
    "url": "https://fujifilm-dsc.com/en/manual/gfx100s/about_this_camera/parts/index.html",
    "title": "FUJIFILM GFX100S Owner's Manual",
    "pages": [
      2,
      3,
      8
    ]
  },
  "boot": {
    "service": {
      "usb": true,
      "hold": [
        {
          "id": "rear_command_dial.press"
        },
        {
          "id": "shutter_button",
          "stage": "full"
        }
      ]
    }
  },
  "controls": {
    "rear_command_dial": {
      "name": "Rear command dial",
      "location": "rear",
      "manual_page": 3,
      "short_name": "REAR DIAL",
      "assignable": true,
      "pushable": true,
      "mechanical": false,
      "behavior": {
        "kind": "dial",
        "motion": {
          "kind": "steps"
        }
      }
    },
    "shutter_button": {
      "name": "Shutter button",
      "location": "top",
      "manual_page": 2,
      "short_name": "SHUTTER",
      "assignable": false,
      "pushable": true,
      "mechanical": false,
      "behavior": {
        "kind": "shutter",
        "stages": {
          "full_press": null,
          "half_press": null
        }
      }
    }
  }
}
