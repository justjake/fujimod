      "serial_flash": {
        "basis": "The X-T4 NOR is a Micron MT35XU512ABA, 64 MiB, JEDEC ID 2c 5b 1a. The model returns the identity bytes in one data word, first byte lowest, so the declared word is 0x1a5b2c: the stock loader takes the low byte as the manufacturer and stores 0x2c, the manufacturer the firmware reads from boot information offset 0x5cc. Erase and page timing are declared virtual inputs.",
        "contents": "registered-update",
        "geometry": {
          "basis": "128 KiB erase sectors and 256-byte pages of the MT35XU512ABA; erase and page timing are declared virtual inputs.",
          "erase_bytes": 131072,
          "erase_ticks": 4096,
          "page_bytes": 256,
          "page_ticks": 512
        },
        "jedec_id": 1727276
      },
      "gpio_interrupts": {
        "basis": "Stabilizer ready pad 0.4 on two level-sensitive interrupt inputs: GIC 171 is asserted while the pad is low (the controller has booted after its reset release) and GIC 155 while it is high (the controller has answered the first frame of its link). The camera waits on each in turn while it opens the link.",
        "routes": [
          {
            "port": 0,
            "pin": 4,
            "line": 171,
            "active_high": false
          },
          {
            "port": 0,
            "pin": 4,
            "line": 155,
            "active_high": true
          }
        ]
      },
      "spi_inputs": {
        "1": {
          "basis": "Declared catalog input.",
          "level": "low",
          "power_checksum_registers": {
            "basis": "Four-byte checksum frames: X-T4 2.12 clocks each power-controller frame as four bytes, most significant first (0x011d4388): a seven-bit register with a write flag, a data word and a checksum byte that brings the byte sum to 0xff (0x011d52fc builds a read). The loader reads the eight-byte settings profile header from registers 31..34 and stores it at boot-information offset 0x148; the board serves the requested profile header there. Startup writes 0x0100 to register 18 and the settings and power code write registers 2, 31..34 and 39 back, so these are stored words. The stock loader that runs from flash before the kernel writes 0x7f00 to register 17, the value the firmware's power-register cache holds, so register 17 is declared a stored word too. The firmware reads register 0 through XOR 0x3407 (0x0225bdb0, 0x0225ef70); 0x3007 leaves only bit 0x400 active, which startup (0x01291324) needs to continue a boot with reason 4. Registers 2, 3, 4, 5, 14, 17, 29, 30, 39, 47..50, 64, 65, 67, 71, 72, 111..114 and 118..121 are the last values in the firmware's power-register cache, and 37, 38, 69 and 70 the values in its power-register shadow, in RAM of a running X-T4 2.12 read in USB service mode. Registers 35 (low) and 36 (high) are a seconds-since-2000 clock, declared stopped at zero. Physical values at power-on are not measured.",
            "chip_select": {
              "active_high": true,
              "pin": 5,
              "port": 12
            },
            "disable_writes": [],
            "inputs": {
              "0": 12295,
              "111": 0,
              "112": 0,
              "113": 0,
              "114": 0,
              "118": 0,
              "119": 0,
              "120": 0,
              "121": 0,
              "14": 2065,
              "17": 32512,
              "2": 9761,
              "29": 65535,
              "3": 641,
              "30": 65535,
              "31": 0,
              "32": 0,
              "33": 0,
              "34": 0,
              "35": 0,
              "36": 0,
              "37": 0,
              "38": 0,
              "39": 3,
              "4": 0,
              "47": 2200,
              "48": 484,
              "49": 25622,
              "5": 0,
              "50": 2970,
              "64": 0,
              "65": 0,
              "67": 160,
              "69": 0,
              "70": 0,
              "71": 31,
              "72": 17
            },
            "retained_registers": [
              2,
              17,
