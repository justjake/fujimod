{
  "$schema": "https://fujimod.com/schemas/body.schema.json",
  "schema": 1,
  "id": "xt4",
  "soc_id": "xp4",
  "dram_bytes": 536870912,
  "hardware": {
    "profiles": {
      "xt4-discovery": {
        "dram_basis": "Declared catalog input."
      }
    },
    "serial_attachments": [
      {
        "part_id": "xt3-power-registers",
        "controller_id": "spi1",
        "connection_id": "xt3-power-registers-bus",
        "select_connection_id": "xt3-power-registers-select"
      }
    ],
    "thermal_connection_ids": [
      "thermal-0",
      "thermal-8",
      "thermal-10"
    ]
  },
  "connections": [
    {
      "id": "flash-storage",
      "kind": "control"
    },
    {
      "id": "xt3-power-registers-bus",
      "kind": "power-control"
    },
    {
      "id": "xt3-power-registers-select",
      "kind": "power-control",
      "signals": [
        {
          "kind": "gpio",
          "port": 12,
          "pin": 5,
          "active_level": true
        }
      ]
    },
    {
      "id": "thermal-0",
      "kind": "control",
      "signals": [
        {
          "kind": "adc",
          "channel": 0
        }
      ]
    },
    {
      "id": "thermal-8",
      "kind": "control",
      "signals": [
        {
          "kind": "adc",
          "channel": 8
        }
      ]
    },
    {
      "id": "thermal-10",
      "kind": "control",
      "signals": [
        {
          "kind": "adc",
          "channel": 10
        }
      ]
    }
  ],
  "parts": [
    "xt4-serial-nor",
    "xt3-power-registers",
    "xt3-image-sensor"
  ],
  "wiring": [
    {
      "source_id": "serial-flash",
      "target_id": "xt4-serial-nor",
      "signal": "storage"
    },
    {
      "source_id": "spi1",
      "target_id": "xt3-power-registers",
      "signal": "serial_data"
    },
    {
      "source_id": "xt3-image-sensor",
      "target_id": "imaging-receiver",
      "signal": "image_data"
    }
  ]
}
