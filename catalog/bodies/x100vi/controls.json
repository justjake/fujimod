{
  "$schema": "https://fujimod.com/schemas/physical-controls.schema.json",
  "schema": 1,
  "id": "x100vi-controls",
  "body_id": "x100vi",
  "manual": {
    "url": "https://app.fujifilm-dsc.com/en/manual/x100vi/x100vi_manual_en_s_f.pdf",
    "title": "FUJIFILM X100VI Owner’s Manual (BL00005311-204 EN)",
    "pages": [
      2, 4, 5, 6, 7, 8, 9, 10, 12, 23, 28, 30, 31, 32, 34, 45, 54, 55, 58, 68, 71, 72, 74, 78, 86,
      91, 95, 98, 240, 293, 295, 297, 298, 299, 300, 319, 320, 321, 322, 324, 325, 328, 330
    ]
  },
  "analog_levels": 1024,
  "boot": {
    "sd": {
      "usb": false,
      "hold": [
        {
          "id": "front_command_dial.press"
        },
        {
          "id": "rear_command_dial.press"
        }
      ]
    },
    "firmware_update": {
      "hold": [
        {
          "id": "disp_back_button"
        }
      ]
    }
  },
