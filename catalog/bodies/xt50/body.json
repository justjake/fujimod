{
  "$schema": "https://fujimod.com/schemas/body.schema.json",
  "schema": 1,
  "id": "xt50",
  "soc_id": "xp5",
  "hardware": {
    "profiles": {
      "xt50": {
        "dram_basis": "Installed capacity is unmeasured; the update's memory map and Linux device tree bound the address space only.",
        "limits": []
      }
    },
    "serial_attachments": [
      {
        "part_id": "power-controller",
        "controller_id": "spi8",
        "connection_id": "power-controller-bus",
        "select_connection_id": "power-controller-select"
      }
    ],
    "thermal_connection_ids": ["thermal-0"]
  },
  "connections": [
    {
      "id": "power-controller-bus",
      "kind": "power-control"
    },
    {
      "id": "power-controller-select",
      "kind": "power-control",
      "signals": [
        {
          "kind": "gpio",
          "port": 15,
          "pin": 15,
          "active_level": true
        }
      ]
    },
    {
      "id": "thermal-0",
      "kind": "control",
      "signals": [
        {
          "kind": "adc",
          "channel": 0
        }
      ]
    }
  ],
  "parts": ["power-controller"],
  "wiring": [
    {
      "source_id": "spi8",
      "target_id": "power-controller",
      "signal": "serial_data"
    }
  ]
}
