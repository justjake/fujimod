  "ladders": [
    {
      "wire": {
        "kind": "adc",
        "channel": 1
      },
      "levels": 4096,
      "released": null,
      "basis": "The firmware caches ADC channel 1 at 0x225c918 + 2 * channel (observed in an emulator run with a distinct sample on every channel) and reads it as a 12-bit value. No released level is established here: it is the run's ADC sample for this channel.",
      "rungs": [
        {
          "control_id": "drive_delete_button",
          "band_low": 2618,
