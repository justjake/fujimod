{
  "$schema": "https://fujimod.com/schemas/physical-controls.schema.json",
  "schema": 1,
  "id": "xe4-controls",
  "body_id": "xe4",
  "manual": {
    "url": "https://app.fujifilm-dsc.com/en/manual/x-e4/x-e4_manual_en_s_f.pdf",
    "title": "X-E4 Owner's Manual (English)",
    "pages": [
      2,
      3,
      4,
      5,
      6,
      9,
      16,
      19,
      21,
      22,
      23,
      24,
      25,
      29,
      30,
      35,
      44,
      45,
      46,
      56,
      57,
      59,
      60,
      67,
      80,
      81,
      85,
      86,
      183,
      224,
      225,
      226,
      253,
      254,
      256
    ]
  },
  "boot": {
    "sd": {
      "usb": false,
      "hold": [
        {
          "id": "front_command_dial.press"
        },
        {
          "id": "fn_button"
        }
      ]
    },
    "firmware_update": {
      "hold": [
        {
          "id": "disp_back_button"
        }
      ]
    }
  },
  "controls": {
    "ael_afl_button": {
      "name": "AEL (exposure lock)/AFL (focus lock) button",
      "location": "rear",
      "manual_page": 3,
      "face": "AEL/AFL",
      "assignable": true,
      "pushable": true,
      "default_function": "Lock exposure and focus.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "battery_chamber_cover_latch": {
      "name": "Battery-chamber cover latch",
      "location": "bottom",
      "manual_page": 3,
      "short_name": "COVER",
      "assignable": false,
      "pushable": false,
      "default_function": "Slide to open or close the battery-chamber cover.",
      "mechanical": true
    },
    "battery_latch": {
      "name": "Battery latch",
      "location": "bottom",
      "manual_page": 3,
      "short_name": "BATTERY",
      "assignable": false,
      "pushable": true,
      "default_function": "Press to release the battery for removal.",
      "mechanical": true
    },
    "diopter_adjustment_control": {
      "name": "Diopter adjustment control",
      "location": "rear",
      "manual_page": 3,
      "short_name": "DIOPTER",
      "assignable": false,
      "pushable": false,
      "default_function": "Adjust the viewfinder display focus until its indicators appear sharp.",
      "mechanical": true
    },
    "disp_back_button": {
      "name": "DISP (display)/BACK button",
      "location": "rear",
      "manual_page": 3,
      "face": "DISP/BACK",
      "connection_ids": [
        "controls-adc-3"
      ],
      "assignable": false,
      "pushable": true,
      "default_function": "Control the display of indicators in the viewfinder, LCD monitor, and playback display; back out of a menu or dialog.",
      "mechanical": false,
      "behavior": {
        "kind": "button",
        "press": {
          "kind": "debug_key",
          "name": "DISP_B"
        }
      }
    },
    "drive_delete_button": {
      "name": "DRIVE/DELETE button",
      "location": "rear",
      "manual_page": 3,
      "face": "DRIVE",
      "assignable": false,
      "pushable": true,
      "default_function": "Display the drive-mode menu; delete pictures during playback.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "exposure_compensation_dial": {
      "name": "Exposure compensation dial",
      "location": "top",
      "manual_page": 2,
      "short_name": "EV",
      "assignable": false,
      "pushable": false,
      "positions": [
        {
          "id": "-3",
          "label": "-3"
        },
        {
          "id": "-2",
          "label": "-2"
        },
        {
          "id": "-1",
          "label": "-1"
        },
        {
          "id": "0",
          "label": "0"
        },
        {
          "id": "+1",
          "label": "+1"
        },
        {
          "id": "+2",
          "label": "+2"
        },
        {
          "id": "+3",
          "label": "+3"
        },
        {
          "id": "C",
          "label": "C"
        }
      ],
      "default_function": "Choose an exposure compensation amount; at C, compensation can be adjusted with the front command dial.",
      "mechanical": false,
      "behavior": {
        "kind": "dial",
        "motion": {
          "kind": "positions",
          "positions": [
            {
              "id": "-3"
            },
            {
              "id": "-2"
            },
            {
              "id": "-1"
            },
            {
              "id": "0"
            },
            {
              "id": "+1"
            },
            {
              "id": "+2"
            },
            {
              "id": "+3"
            },
            {
              "id": "C"
            }
          ]
        }
      }
    },
    "fn_button": {
      "name": "Fn button",
      "location": "top",
      "manual_page": 2,
      "face": "Fn",
      "assignable": true,
      "pushable": true,
      "default_function": "Adjust white balance.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "focus_stick": {
      "name": "Focus stick (focus lever)",
      "location": "rear",
      "manual_page": 3,
      "short_name": "FOCUS",
      "connection_ids": [
        "controls-adc-2"
      ],
      "assignable": true,
      "pushable": true,
      "default_function": "Tilt or press to select the focus area and navigate menus; the center and tilt roles can be configured.",
      "mechanical": false,
      "behavior": {
        "kind": "pad",
        "directions": {
          "up": {
            "kind": "debug_key",
            "name": "8DIR_U"
          },
          "down": {
            "kind": "debug_key",
            "name": "8DIR_D"
          },
          "left": {
            "kind": "debug_key",
            "name": "8DIR_L"
          },
          "right": {
            "kind": "debug_key",
            "name": "8DIR_R"
          }
        }
      }
    },
    "front_command_dial": {
      "name": "Front command dial",
      "location": "front",
      "manual_page": 2,
      "short_name": "FRONT DIAL",
      "assignable": true,
      "pushable": true,
      "default_function": "Rotate to adjust the selected command; at default, its roles are program shift or shutter speed, aperture, and exposure compensation. Press the center to cycle roles.",
      "mechanical": false,
      "behavior": {
        "kind": "dial",
        "motion": {
          "kind": "steps"
        }
      }
    },
    "lens_release_button": {
      "name": "Lens release button",
      "location": "front",
      "manual_page": 2,
      "short_name": "LENS",
      "assignable": false,
      "pushable": true,
      "default_function": "Release the attached lens so it can be rotated and removed.",
      "mechanical": true
    },
    "menu_ok_button": {
      "name": "MENU/OK button",
      "location": "rear",
      "manual_page": 3,
      "face": "MENU/OK",
      "connection_ids": [
        "controls-adc-3"
      ],
      "assignable": false,
      "pushable": true,
      "default_function": "Display the menus and confirm selections.",
      "mechanical": false,
      "behavior": {
        "kind": "button",
        "press": {
          "kind": "debug_key",
          "name": "EXE_M"
        }
      }
    },
    "on_off_switch": {
      "name": "ON/OFF switch",
      "location": "top",
      "manual_page": 2,
      "face": "ON/OFF",
      "assignable": false,
      "pushable": false,
      "positions": [
        {
          "id": "ON",
          "label": "ON"
        },
        {
          "id": "OFF",
          "label": "OFF"
        }
      ],
      "default_function": "Turn the camera on or off.",
      "mechanical": false,
      "behavior": {
        "kind": "switch",
        "positions": [
          {
            "id": "ON"
          },
          {
            "id": "OFF"
          }
        ]
      }
    },
    "play_button": {
      "name": "PLAY (playback) button",
      "location": "rear",
      "manual_page": 3,
      "icon": "playback",
      "connection_ids": [
        "controls-gpio-7-6"
      ],
      "assignable": false,
      "pushable": true,
      "default_function": "Start playback; half-press the shutter button to return to shooting.",
      "mechanical": false,
      "behavior": {
        "kind": "button",
        "press": {
          "kind": "debug_key",
          "name": "K_PLAY"
        }
      }
    },
    "q_button": {
      "name": "Q (quick menu) button",
      "location": "rear",
      "manual_page": 2,
      "face": "Q",
      "assignable": true,
      "pushable": true,
      "default_function": "Display the Quick Menu.",
      "mechanical": false,
      "behavior": {
        "kind": "button"
      }
    },
    "shutter_button": {
      "name": "Shutter button",
      "location": "top",
      "manual_page": 2,
      "short_name": "SHUTTER",
      "connection_ids": [
        "controls-gpio-0-0",
        "controls-gpio-0-1"
      ],
      "assignable": false,
      "pushable": true,
      "positions": [
        {
          "id": "half-press",
          "label": "half-press"
        },
        {
          "id": "full press",
          "label": "full press"
        }
      ],
      "default_function": "Half-press to focus and lock focus and exposure when SHUTTER AF and SHUTTER AE are on; press fully to take a picture.",
      "mechanical": false,
      "behavior": {
        "kind": "shutter",
        "stages": {
          "full_press": [
            {
              "kind": "debug_key",
              "name": "S2"
            }
          ],
          "half_press": [
            {
              "kind": "debug_key",
              "name": "S1"
            }
          ]
        }
      }
    },
    "shutter_speed_dial": {
      "name": "Shutter speed dial",
      "location": "top",
      "manual_page": 2,
      "short_name": "SPEED",
      "assignable": false,
      "pushable": false,
      "positions": [
        {
          "id": "P",
          "label": "P"
        },
        {
          "id": "A",
          "label": "A"
        },
        {
