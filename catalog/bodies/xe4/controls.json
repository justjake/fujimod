            {
              "id": "4"
            },
            {
              "id": "2"
            },
            {
              "id": "1"
            },
            {
              "id": "T"
            },
            {
              "id": "B"
            }
          ]
        }
      }
    },
    "touchscreen": {
      "name": "Touch screen",
      "location": "rear",
      "manual_page": 3,
      "assignable": true,
      "pushable": false,
      "default_function": "Use touch controls for photography, focus-area selection, function selection, movie controls, and playback; touch-function gestures are disabled by default.",
      "mechanical": false,
      "behavior": {
        "kind": "touch"
      }
    }
  }
}
