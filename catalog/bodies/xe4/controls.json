        },
        {
          "id": "T",
          "label": "T"
        },
        {
          "id": "B",
          "label": "B"
        }
      ],
      "default_function": "Choose the shutter speed.",
      "mechanical": false,
      "behavior": {
        "kind": "dial",
        "motion": {
          "kind": "positions",
          "positions": [
            {
              "id": "P"
            },
            {
              "id": "A"
            },
            {
              "id": "4000"
            },
            {
              "id": "2000"
            },
            {
