      "positions": [
        {
          "id": "spot",
          "label": "icon",
          "description": "The camera meters lighting conditions in an area at the center of the frame equivalent to 2% of the total. Recommended with backlit subjects and in other cases in which the background is much brighter or darker than the main subject."
        },
        {
          "id": "center_weighted",
          "label": "icon",
          "description": "The camera meters the entire frame but assigns the greatest weight to the area at the center."
        },
        {
          "id": "multi",
          "label": "icon",
          "description": "The camera instantly determines exposure based on an analysis of composition, color, and brightness distribution. Recommended in most situations."
        },
        {
