{
  "$schema": "https://fujimod.com/schemas/physical-controls.schema.json",
  "schema": 1,
  "id": "xt2-controls",
  "body_id": "xt2",
  "manual": {
    "url": "https://fujifilm-dsc.com/en/manual/x-t2/x-t2_omw_en_s_f.pdf",
    "title": "FUJIFILM X-T2 Version 2.10 Owner's Manual",
    "pages": [
      2, 3, 4, 5, 6, 7, 11, 16, 18, 29, 34, 36, 37, 42, 50, 51, 52, 64, 66, 72, 75, 80, 88, 91, 92,
      93, 94, 223, 226, 227, 228, 229, 230, 231, 232, 251, 256, 257, 258
    ]
  },
  "analog_levels": 1024,
  "boot": {
    "sd": {
      "usb": false,
      "hold": [
        {
          "id": "rear_command_dial.press"
        },
        {
          "id": "fn1_button"
        }
      ]
    },
    "firmware_update": {
      "hold": [
        {
          "id": "disp_back_button"
        }
      ]
    },
    "service": {
      "usb": true,
      "hold": [
        {
          "id": "selector_up_button"
        },
        {
          "id": "shutter_button",
          "stage": "full"
        }
      ]
    }
  },
