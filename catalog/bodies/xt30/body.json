    "profiles": {
      "xt30-discovery": {
        "dram_basis": "Installed DRAM capacity is unknown; this profile makes no body-level capacity claim."
      },
      "xt30-boot": {
        "dram_basis": "Run-level virtual memory bound; installed capacity is unknown."
      }
    }
