        {
          "kind": "adc",
          "channel": 2,
          "threshold": null
        }
      ]
    },
    {
      "id": "xt30-thermal-4",
      "kind": "control",
      "signals": [
        {
          "kind": "adc",
          "channel": 4,
          "threshold": null
        }
      ]
    },
    {
      "id": "xt30-thermal-10",
      "kind": "control",
      "signals": [
        {
          "kind": "adc",
          "channel": 10,
          "threshold": null
        }
      ]
    }
  ],
  "parts": [
    "xt30-boot-nor",
    "xt30-boot-power"
