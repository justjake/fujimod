            "kind": "debug_key",
            "name": "UP"
          },
          "down": {
            "kind": "debug_key",
            "name": "DOWN"
          },
          "left": {
            "kind": "debug_key",
            "name": "LEFT"
          },
          "right": {
            "kind": "debug_key",
            "name": "RIGHT"
