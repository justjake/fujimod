{
  "$schema": "https://fujimod.com/schemas/physical-controls.schema.json",
  "schema": 1,
  "id": "x30-controls",
  "body_id": "x30",
  "manual": {
    "url": "https://fujifilm-dsc.com/en/manual/x30/x30_om-full_en_01.pdf",
    "title": "FUJIFILM X30 Owner's Manual",
    "pages": [
      12, 13, 14, 15, 16, 17, 18, 19, 22, 24, 25, 26, 27, 28, 47, 64, 68, 75, 98, 101, 112, 118,
      119, 120, 121, 124, 125, 168, 183, 218, 219, 224, 225, 236
    ]
  },
  "analog_levels": 1024,
  "boot": {
    "sd": {
      "hold": [
        {
          "id": "command_dial.press"
        },
        {
          "id": "view_mode_button"
        }
      ]
    },
    "firmware_update": {
      "hold": [
        {
          "id": "disp_back_button"
        }
      ]
    }
  },
  "controls": {
    "af_ae_lock_button": {
      "name": "[AEL/AFL] (autoexposure/autofocus lock) button",
      "location": "rear",
      "manual_page": 225,
      "face": "AEL/AFL",
      "connection_ids": ["controls-adc-8"],
      "assignable": true,
      "pushable": true,
      "default_function": "Locks exposure, focus, or both according to the configurable [AE/AF-LOCK BUTTON] setting.",
      "mechanical": false,
      "behavior": {
        "kind": "button",
        "press": {
          "kind": "debug_key",
          "name": "AEAF_LOCK"
        }
      }
    },
    "battery_chamber_cover_latch": {
      "name": "Battery-chamber cover latch",
      "location": "bottom",
      "manual_page": 13,
      "assignable": false,
      "pushable": false,
      "default_function": "Slide to open or close the battery-chamber cover.",
      "mechanical": true
    },
    "battery_latch": {
      "name": "Battery latch",
      "location": "bottom",
      "manual_page": 13,
      "assignable": false,
      "pushable": false,
      "default_function": "Press to the side to release the battery.",
      "mechanical": true
    },
    "command_dial": {
      "name": "Command dial",
      "location": "rear",
      "manual_page": 16,
      "short_name": "COMMAND",
      "connection_ids": ["controls-gpio-0-10", "controls-encoder-3-8-3-9"],
      "assignable": false,
      "pushable": true,
      "default_function": "Navigates menus, views pictures, and selects quick-menu options; pressing its center zooms in on the active focus area.",
      "role": "command_control",
      "mechanical": false,
      "behavior": {
        "kind": "dial",
        "motion": {
          "kind": "steps",
          "decrease": {
            "kind": "debug_key",
            "name": "CMD_LEFT"
          },
          "increase": {
            "kind": "debug_key",
            "name": "CMD_RIGHT"
          }
        },
        "press": {
          "kind": "debug_key",
          "name": "CMD_PUSH"
        }
      }
    },
    "control_ring": {
      "name": "Control ring",
      "location": "front",
      "manual_page": 17,
      "short_name": "LENS",
      "connection_ids": ["controls-encoder-adc-6-7"],
      "assignable": true,
      "pushable": false,
      "default_function": "At [DEFAULT], adjusts program shift ([P]), shutter speed ([S]), aperture ([A]), shutter speed/aperture ([M]), filter selection ([Filter]), advanced mode selection ([Adv.]), or scene selection ([SP1]/[SP2]); it provides manual focus in the applicable modes. Other assignments are ISO, white balance, film simulation, and continuous shooting.",
      "mechanical": false,
      "behavior": {
        "kind": "ring",
        "motion": {
          "kind": "steps",
          "decrease": {
            "kind": "debug_key",
            "name": "CRING-"
          },
          "increase": {
            "kind": "debug_key",
            "name": "CRING+"
          }
        },
        "endless": true
      }
    },
    "control_ring_options_button": {
      "name": "Control ring options button",
      "location": "top",
      "manual_page": 17,
      "face": "Fn",
      "assignable": false,
      "pushable": false,
      "default_function": "Selects the control-ring function from [DEFAULT], [ISO], [WHITE BALANCE], [FILM SIMULATION], or [CONTINUOUS]; in [M] mode it switches between shutter-speed and aperture selection.",
      "mechanical": false
    },
    "delete_button": {
      "name": "Delete button (playback mode)",
      "location": "rear",
      "manual_page": 64,
      "icon": "delete",
      "assignable": false,
      "pushable": true,
      "default_function": "Deletes pictures in playback; the manual describes frame, selected-frame, and all-frame deletion.",
      "mechanical": false,
      "behavior": {
        "kind": "button",
        "press": {
          "kind": "debug_key",
          "name": "DELETE"
        }
      }
    },
    "diopter_adjustment_control": {
      "name": "Diopter adjustment control",
      "location": "rear",
      "manual_page": 22,
      "assignable": false,
      "pushable": false,
      "default_function": "Adjusts the viewfinder display until it is in sharp focus.",
      "mechanical": true
    },
    "disp_back_button": {
      "name": "[DISP] (display)/[BACK] button",
      "location": "rear",
      "manual_page": 24,
      "face": "DISP/BACK",
      "connection_ids": ["controls-adc-8"],
      "assignable": false,
      "pushable": true,
