{
  "$defs": {
    "IdentityCheck": {
      "additionalProperties": false,
      "description": "A stock code range whose digest must hold while REC is observed.",
      "properties": {
        "address": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "sha256": {
          "type": "string"
        },
        "size": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "address",
        "size",
        "sha256"
      ],
      "type": "object"
    },
    "StateWord": {
      "additionalProperties": false,
      "description": "One located state word: its address and width.",
      "properties": {
        "address": {
          "description": "Physical address of the word.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "bytes": {
          "description": "Width in bytes, 1 to 4, little-endian.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "address",
        "bytes"
      ],
      "type": "object"
    }
  },
  "$id": "https://fujimod.com/schemas/rec-readiness.generated.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The located REC state of one firmware.",
  "properties": {
    "$schema": {
      "const": "https://fujimod.com/schemas/rec-readiness.generated.schema.json",
      "description": "Stable schema identifier for this document.",
      "type": "string"
    },
    "firmware_id": {
      "type": "string"
    },
    "firmware_sha256": {
      "description": "SHA-256 of the update the addresses were located in.",
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "identity_checks": {
      "description": "Stock code that must be unchanged while REC is observed.",
      "items": {
        "$ref": "#/$defs/IdentityCheck"
      },
      "type": "array"
    },
    "menu_active": {
      "$ref": "#/$defs/StateWord",
      "description": "The menu flag; zero while no menu is open."
    },
    "pending_mode": {
      "$ref": "#/$defs/StateWord",
      "description": "The UI mode a mode change is about to commit; zero when none is pending."
    },
    "rec_system_mode": {
      "description": "The system mode value the firmware holds at REC.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "rec_ui_mode": {
      "description": "The UI mode value of REC.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "schema": {
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "settle_milliseconds": {
      "description": "How long REC with a drawn screen must hold before the camera is at REC.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "system_mode": {
      "$ref": "#/$defs/StateWord",
      "description": "The system mode the located getter returns."
    },
    "ui_mode": {
      "$ref": "#/$defs/StateWord",
      "description": "The current UI mode."
    }
  },
  "required": [
    "$schema",
    "schema",
    "id",
    "firmware_id",
    "firmware_sha256",
    "ui_mode",
    "pending_mode",
    "system_mode",
    "menu_active",
    "rec_ui_mode",
    "rec_system_mode",
    "settle_milliseconds",
    "identity_checks"
  ],
  "title": "RecReadiness",
  "type": "object"
}
