{
  "$defs": {
    "CodeCheck": {
      "additionalProperties": false,
      "description": "Stock code bytes identified by their SHA-256.",
      "properties": {
        "address": {
          "description": "First address, before `code_alias`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "Routine or region name.",
          "type": "string"
        },
        "sha256": {
          "description": "Lowercase hexadecimal SHA-256 of the stock bytes.",
          "type": "string"
        },
        "size": {
          "description": "Length in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "address",
        "size",
        "sha256"
      ],
      "type": "object"
    },
    "DriverWindow": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "description": "Entry point reached only after its handle check succeeds.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "slot": {
          "description": "Byte offset of the function pointer the entry point calls.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "address",
        "slot"
      ],
      "type": "object"
    },
