          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "functions": {
          "description": "Stock file, dispatch, and cursor entrypoints in the helper ABI's order.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "instruction_barrier": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "instruction_invalidate": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "release": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "worker_slots": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "allocate",
        "release",
        "configuration_pointer",
        "cache_clean",
        "instruction_invalidate",
        "barrier",
        "instruction_barrier",
        "worker_slots",
        "functions",
        "checks"
      ],
      "type": "object"
