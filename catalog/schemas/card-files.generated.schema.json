        {
          "additionalProperties": false,
          "description": "X-Processor Pro storage path, catalogued as driver-table routine and\ncell addresses. The calls are recorded but not executed here.",
          "properties": {
            "address_alias": {
              "description": "Alias bit applied to storage addresses, as in the mailbox reservation.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "context_slot": {
              "description": "Cell holding the driver context passed to the table calls.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "drive_map": {
              "description": "Cell holding the drive-letter map consulted during selection.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "drive_select": {
              "description": "Maps a path's drive letter to the storage unit behind it.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "driver_table": {
              "description": "Table of driver-object pointers the entry points look up by slot.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "driver_table",
              "type": "string"
            },
            "media_queue": {
              "description": "Byte cell holding the media code handed over with each queued packet.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "media_ready": {
              "description": "Reports whether media for the selected drive is present and ready.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "open": {
              "description": "Selects a drive from the path's drive letter through `drive_map` and\ncalls the driver object found in `driver_table`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "packet_bytes": {
              "description": "Size in bytes of the stack frame holding the copied request packet.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "queue_send": {
              "description": "Enqueues a prepared packet for the selected driver object.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "request_packet": {
              "description": "Copies a caller record into a `packet_bytes`-sized stack frame and\nhands it to `queue_send` together with the byte at `media_queue`.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "windows": {
              "description": "Handle-checked entry points that look a driver object up in\n`driver_table` and call the function pointer at `slot`.",
              "items": {
                "$ref": "#/$defs/DriverWindow"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "open",
            "drive_select",
            "drive_map",
            "driver_table",
            "context_slot",
            "media_queue",
            "media_ready",
            "request_packet",
            "queue_send",
            "address_alias",
            "packet_bytes",
            "windows"
          ],
          "type": "object"
        }
      ]
    },
