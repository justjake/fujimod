{
  "$defs": {
    "CursorFields": {
      "additionalProperties": false,
      "description": "Live cursor word offsets.",
      "properties": {
        "cursor": {
          "description": "Cursor.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "filtered_count": {
          "description": "Filtered count.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pointer": {
          "description": "Pointer.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "raw_count": {
          "description": "Raw count.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "subcursor": {
          "description": "Subcursor.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "value_cursor": {
          "description": "Value cursor.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "visible_count": {
          "description": "Visible count.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "pointer",
        "cursor",
        "subcursor",
        "visible_count",
        "value_cursor",
        "raw_count",
        "filtered_count"
      ],
      "type": "object"
    },
    "CursorLayout": {
      "additionalProperties": false,
      "description": "Live menu cursor and status-array offsets.",
      "properties": {
        "fields": {
          "$ref": "#/$defs/CursorFields",
          "description": "Cursor word offsets."
        },
        "size": {
          "description": "Cursor byte size.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "status_offset": {
          "description": "Status byte offset from the cursor base; begins after `size`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "status_stride": {
          "description": "Byte stride between row statuses.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "status_width": {
          "description": "Status scalar width in bytes (1, 2, 4 or 8).",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "size",
        "fields",
        "status_offset",
        "status_stride",
        "status_width"
      ],
      "type": "object"
    },
    "MenuFieldWidths": {
      "additionalProperties": false,
      "description": "Width of each native menu descriptor field, in bytes.",
      "properties": {
        "flags_word": {
          "default": 4,
          "description": "Width of the flags field.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "handlers_pointer": {
          "default": 4,
          "description": "Width of the handlers pointer.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "item_array": {
          "default": 4,
          "description": "Width of the item-array pointer.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "menu_id": {
          "default": 4,
          "description": "Width of the root key decoded from the descriptor.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "parent_pointer": {
          "default": 4,
          "description": "Width of the parent pointer.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "rows_per_page": {
          "default": 4,
          "description": "Width of the rows-per-page count.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "setting_id": {
          "default": 4,
          "description": "Width of the setting identifier.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "type_code": {
          "default": 4,
          "description": "Width of the descriptor type code.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "MenuFields": {
      "additionalProperties": false,
      "description": "Native menu descriptor field offsets.",
      "properties": {
        "flags_word": {
          "description": "Flags word.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "handlers_pointer": {
          "description": "Handlers pointer.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "item_array": {
          "description": "Item array.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "menu_id": {
          "description": "Root key decoded from the descriptor.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "parent_pointer": {
          "description": "Parent pointer.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rows_per_page": {
          "description": "Rows per page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "setting_id": {
          "description": "Setting id.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "type_code": {
          "anyOf": [
            {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Declared type-code offset, or `null` when descriptors have no type field."
        }
      },
      "required": [
        "menu_id",
        "type_code",
        "setting_id",
        "rows_per_page",
        "flags_word",
        "parent_pointer",
        "item_array",
        "handlers_pointer"
      ],
      "type": "object"
    },
    "MenuLayout": {
      "additionalProperties": false,
      "description": "Offsets within a native menu descriptor and row.",
      "properties": {
        "caption_word_order": {
          "default": null,
          "description": "Caption word indices to try in priority order. Omission keeps the legacy\norder: word 1 then word 0 when at least two words are present, otherwise\nword 0.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "caption_words": {
          "description": "Caption words.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "field_widths": {
          "$ref": "#/$defs/MenuFieldWidths",
          "default": {
            "flags_word": 4,
            "handlers_pointer": 4,
            "item_array": 4,
            "menu_id": 4,
            "parent_pointer": 4,
            "rows_per_page": 4,
            "setting_id": 4,
            "type_code": 4
          },
          "description": "Width of each node field in bytes. Omission retains four-byte fields."
        },
        "fields": {
          "$ref": "#/$defs/MenuFields",
          "description": "Node field offsets."
        },
        "max_kind": {
          "description": "Maximum declared type code; ignored when no type-code field is declared.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "nowrap_flags": {
          "description": "Nowrap flags.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "row_child": {
          "description": "Row child.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "row_child_width": {
          "default": 4,
          "description": "Width of the row child pointer in bytes.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "row_key": {
          "description": "Row key.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "row_key_width": {
          "default": 4,
          "description": "Width of the row key in bytes.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        },
        "row_size": {
          "description": "Row size.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sentinel": {
          "description": "Sentinel.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "description": "Node byte size.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "size",
        "fields",
        "row_size",
        "row_key",
        "row_child",
        "caption_words",
        "sentinel",
        "max_kind",
        "nowrap_flags"
      ],
      "type": "object"
    },
    "MenuNavigation": {
      "additionalProperties": false,
      "description": "Native menu tab bounds.",
      "properties": {
        "setup_first_tab": {
          "description": "Setup first tab.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "shooting_first_tab": {
          "description": "Shooting first tab.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "shooting_last_tab": {
          "description": "Shooting last tab.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "shooting_first_tab",
        "shooting_last_tab",
        "setup_first_tab"
      ],
      "type": "object"
    },
    "QuickGrid": {
      "additionalProperties": false,
      "description": "Quick menu dimensions.",
      "properties": {
        "columns": {
          "description": "Columns.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "menu_code": {
          "description": "Menu code.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rows": {
          "description": "Rows.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "rows",
        "columns",
        "menu_code"
      ],
      "type": "object"
    },
    "RootLayout": {
      "description": "Representation of the live root table.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A 32-bit pointer array; the array index is the root key.",
          "properties": {
            "kind": {
              "const": "pointer_array",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Entries contain a sized integer key and a 32-bit pointer.",
          "properties": {
            "key_offset": {
              "description": "Byte offset of the key within each entry.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "key_width": {
              "description": "Key width in bytes.",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "keyed_entries",
              "type": "string"
            },
            "pointer_offset": {
              "description": "Byte offset of the 32-bit pointer within each entry.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "stride": {
              "description": "Entry stride in bytes.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "stride",
            "key_offset",
            "key_width",
            "pointer_offset"
          ],
          "type": "object"
        }
      ]
    },
    "RootRoute": {
      "additionalProperties": false,
      "description": "A root menu entry strategy.",
      "properties": {
        "entry": {
          "description": "Navigation role used to open the root.",
          "type": "string"
        },
        "tab": {
          "default": null,
          "description": "Optional tab key.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "entry"
      ],
      "type": "object"
    }
  },
  "$id": "https://fujimod.com/schemas/remote-menus.generated.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Live menu roots, row descriptors and navigation.",
  "properties": {
    "cursor": {
      "$ref": "#/$defs/CursorLayout",
      "description": "Cursor and row status layout."
    },
    "cursor_address": {
      "description": "Cursor structure base.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "layout": {
      "$ref": "#/$defs/MenuLayout",
      "description": "Node and row layout."
    },
    "navigation": {
      "$ref": "#/$defs/MenuNavigation",
      "description": "Tab navigation bounds."
    },
    "page_tabs": {
      "additionalProperties": false,
      "description": "Root keys mapped to first tab keys.",
      "patternProperties": {
        "^\\d+$": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "q_grid": {
      "$ref": "#/$defs/QuickGrid",
      "description": "Quick menu geometry and menu ID."
    },
    "roles": {
      "additionalProperties": {
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "description": "Named root keys (array indices for a pointer array).",
      "type": "object"
    },
    "root_count": {
      "description": "Number of entries in the root table.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "root_layout": {
      "$ref": "#/$defs/RootLayout",
      "default": {
        "kind": "pointer_array"
      },
      "description": "How root entries are represented. Omission retains the 32-bit pointer\narray, with the entry index serving as its root key."
    },
    "root_routes": {
      "additionalProperties": false,
      "description": "Declared root entry strategies.",
      "patternProperties": {
        "^\\d+$": {
          "$ref": "#/$defs/RootRoute"
        }
      },
      "type": "object"
    },
    "root_titles": {
      "additionalProperties": false,
      "description": "Root keys mapped to caption resource IDs.",
      "patternProperties": {
        "^\\d+$": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "roots_address": {
      "description": "Address of the root table.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "roots_address",
    "root_count",
    "roles",
    "root_titles",
    "root_routes",
    "page_tabs",
    "navigation",
    "layout",
    "cursor_address",
    "cursor",
    "q_grid"
  ],
  "title": "MenuTables",
  "type": "object"
}
