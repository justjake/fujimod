    "LinkedChoice": {
      "additionalProperties": false,
      "description": "One declared choice slot of a linked-choice row.",
      "properties": {
        "label": {
          "description": "The choice's caption.",
          "type": "string"
        },
        "linked": {
          "description": "Whether the build links the object that offers this choice.",
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "linked"
      ],
      "type": "object"
    },
    "LinkedSymbol": {
      "additionalProperties": false,
      "description": "Linked symbol identity.",
      "properties": {
        "address": {
          "description": "Linked address.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "description": "Declared byte size.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "address",
        "size"
      ],
      "type": "object"
    },
    "MenuItem": {
      "additionalProperties": false,
      "description": "One compiled UI owner with placement and stable option identities.",
      "properties": {
        "activate": {
          "description": "Activate.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "address": {
          "description": "Address.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "binding": {
          "description": "Binding.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "choice_capacity": {
          "description": "Declared choice capacity.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "choice_count": {
          "description": "Selectable choice count.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "event": {
          "description": "Event.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "fn_action": {
          "description": "Fn action.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "identity": {
          "description": "Identity.",
          "type": "string"
        },
        "inline": {
          "anyOf": [
            {
              "$ref": "#/$defs/InlineChoices"
            },
            {
              "type": "null"
            }
          ],
          "description": "Inline."
        },
        "input": {
          "description": "Input.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "key": {
          "description": "Native row key.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "label": {
          "description": "Label.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "label_text": {
          "description": "Declared label.",
          "type": "string"
        },
        "linked_choices": {
          "description": "Every declared slot of a row whose choices exist only when another\nlinked object does, in slot order, and whether this build links it.",
          "items": {
            "$ref": "#/$defs/LinkedChoice"
          },
          "type": "array"
        },
        "mod": {
          "description": "Owning_mod.",
          "type": "string"
        },
        "name": {
          "description": "Name.",
          "type": "string"
        },
        "native": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeSetting"
            },
            {
              "type": "null"
            }
          ],
          "description": "Native."
        },
        "open_page": {
          "description": "Open page.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "options": {
          "description": "Stable named choices; open catalogs may have unnamed entries.",
          "items": {
            "$ref": "#/$defs/MenuOption"
          },
          "type": "array"
        },
        "page": {
          "description": "Page.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "parent": {
          "description": "Parent.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "parent_item": {
          "description": "Parent item.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "q_assignable": {
          "description": "Whether Q assignment is declared.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "stock_node": {
          "description": "Stock node.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "stock_parent_setting": {
          "description": "Stock parent setting.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "surfaces": {
          "description": "Declared surfaces.",
          "items": {
            "$ref": "#/$defs/Surface"
          },
          "type": "array"
        }
      },
      "required": [
