        },
        "page": {
          "description": "Page.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "parent": {
          "description": "Parent.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "parent_item": {
          "description": "Parent item.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "q_assignable": {
          "description": "Q assignable.",
