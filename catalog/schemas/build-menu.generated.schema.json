{
  "$defs": {
    "BindingActionChoice": {
      "description": "An action offered in a binding picker.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A declared action with its registry identity.",
          "properties": {
            "action_id": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "declared",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "action_id",
            "name"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "A legacy action identified by its saved binding identity.",
          "properties": {
            "binding_id": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "legacy",
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "binding_id",
            "name"
          ],
          "type": "object"
        }
      ]
    },
    "BindingApply": {
      "additionalProperties": false,
      "description": "Accepted binding-choice writer and its compiled menu owners.",
      "properties": {
        "callback": {
          "description": "Linked callback entry.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "controls": {
          "description": "Control IDs and their selected choice records.",
          "items": {
            "$ref": "#/$defs/BindingApplyControl"
          },
          "type": "array"
        },
        "function_action": {
          "description": "Generated action ID for the computed function picker; zero when absent.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "function_owner": {
          "description": "Record that owns the compiled function choices.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "callback",
        "function_owner",
        "function_action",
        "controls"
      ],
      "type": "object"
    },
    "BindingApplyControl": {
      "additionalProperties": false,
      "description": "Compiled row and choice owners for one control ID.",
      "properties": {
        "choice_owner": {
          "description": "Record whose choices are committed for the control.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "control": {
          "description": "Control ID accepted by the writer.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "function_item": {
          "description": "High 16-bit item handle carried by the composite function action ID;\nzero when absent.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "row_owner": {
          "description": "Menu row representing the control.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "control",
        "row_owner",
        "choice_owner",
        "function_item"
      ],
      "type": "object"
    },
    "BindingChoices": {
      "additionalProperties": false,
      "description": "Exact binding picker owners.",
      "properties": {
        "accepted_apply": {
          "anyOf": [
            {
              "$ref": "#/$defs/BindingApply"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Accepted writer and control owners for compiled function choices."
        },
        "count": {
          "description": "Selectable count.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "mod_actions": {
          "description": "Action identities in their selectable order.",
          "items": {
            "$ref": "#/$defs/BindingActionChoice"
          },
          "type": "array"
        },
        "mod_owners": {
          "description": "Curated mod owners.",
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "native_owners": {
          "description": "Native prefix owners.",
          "items": {
            "format": "uint64",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "count",
        "native_owners",
        "mod_owners",
        "mod_actions"
      ],
      "type": "object"
    },
    "BindingLayout": {
      "additionalProperties": false,
      "description": "Compiler-produced BindingLayout offsets.",
      "properties": {
        "apply": {
          "description": "Apply.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "binding_size": {
          "description": "Binding size.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "capacity": {
          "description": "Capacity.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "magic": {
          "description": "Magic.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "description": "Version.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "magic",
        "version",
        "binding_size",
        "apply",
        "capacity"
      ],
      "type": "object"
    },
    "BuildArtifact": {
      "additionalProperties": false,
      "description": "A build output bound to this manifest.",
      "properties": {
        "file": {
          "description": "Relative build file.",
          "type": "string"
        },
        "sha256": {
          "description": "Content digest.",
          "type": "string"
        },
        "size": {
          "description": "Byte length.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "file",
        "size",
        "sha256"
      ],
      "type": "object"
    },
    "BuildMemory": {
      "additionalProperties": false,
      "description": "A linked address range backed by an installed artifact.",
      "properties": {
        "address": {
          "description": "Address.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "file": {
          "description": "File.",
          "type": "string"
        },
        "offset": {
          "description": "Offset.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "description": "Size.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "address",
        "size",
        "file",
        "offset"
      ],
      "type": "object"
    },
    "CanvasHost": {
      "additionalProperties": false,
      "description": "Declared canvas screen identities.",
      "properties": {
        "identity": {
          "description": "Owning menu identity.",
          "type": "string"
        },
        "screens": {
          "description": "Declared screen IDs.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "identity",
        "screens"
      ],
      "type": "object"
    },
    "CanvasLayout": {
      "additionalProperties": false,
      "description": "Compiler-produced CanvasLayout offsets.",
      "properties": {
        "host_size": {
          "description": "Host size.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "id": {
          "description": "Id.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "live_busy": {
          "description": "Live busy.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "live_host": {
          "description": "Live host.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "live_screen": {
          "description": "Live screen.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "magic": {
          "description": "Magic.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "screen_count": {
          "description": "Screen count.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "screen_size": {
          "description": "Screen size.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "screens": {
          "description": "Screens.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "version": {
          "description": "Version.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "magic",
        "version",
        "host_size",
        "screens",
        "screen_count",
        "screen_size",
        "id",
        "live_host",
        "live_screen",
        "live_busy"
      ],
      "type": "object"
    },
