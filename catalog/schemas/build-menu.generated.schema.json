    "MenuOption": {
      "additionalProperties": false,
      "description": "Stable option identity and native key.",
      "properties": {
        "key": {
          "description": "Native choice key or normalized option index.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "Stable name supplied by the declaration.",
          "type": "string"
        },
        "value": {
          "description": "Persisted value when declared.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "key"
      ],
      "type": "object"
    },
    "MenuTreeAttachment": {
      "additionalProperties": false,
      "description": "A declared root's placement in a stock menu.",
      "properties": {
        "anchor": {
          "description": "Stock menu anchor.",
          "type": "string"
        },
        "order": {
          "description": "Order among roots at this anchor and placement.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "place": {
          "$ref": "#/$defs/MenuTreePlace",
          "description": "How the root is placed at the anchor."
        },
        "record": {
          "description": "Existing record symbol when the mod supplies one.",
          "type": "string"
        },
        "root": {
          "description": "Declared root path.",
          "type": "string"
        }
      },
      "required": [
        "root",
        "anchor",
        "place",
        "order",
        "record"
      ],
      "type": "object"
    },
    "MenuTreeCatalog": {
      "additionalProperties": false,
      "description": "Static FM_MENU declarations used by the compiled menu-tree provider.",
      "properties": {
        "attachments": {
          "description": "Declared roots attached at stock menu anchors.",
          "items": {
            "$ref": "#/$defs/MenuTreeAttachment"
          },
          "type": "array"
        },
        "nodes": {
          "description": "Declared tree nodes in provider order.",
          "items": {
            "$ref": "#/$defs/MenuTreeNode"
          },
          "type": "array"
        },
        "schema": {
          "description": "Format version.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "nodes",
        "attachments"
      ],
      "type": "object"
    },
    "MenuTreeNode": {
      "additionalProperties": false,
      "description": "One declared node and its stable owner/path identity.",
      "properties": {
        "action": {
          "description": "Action named by a VALUE or COMMAND node, when present.",
          "type": "string"
        },
        "id": {
          "description": "Number assigned by the menu declaration generator.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "identity": {
          "description": "Stable owner/name identity.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/MenuTreeNodeKind",
          "description": "Declared menu-node kind."
        },
        "label_text": {
          "description": "Static label literal, or empty when the provider supplies it at runtime.",
          "type": "string"
        },
        "name": {
          "description": "Name within its declaring tree, including its path from that tree's root.",
          "type": "string"
        },
        "order": {
          "description": "Position among the node's siblings or attached roots.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "owner": {
          "description": "Owning mod or library.",
          "type": "string"
        },
        "parent": {
          "description": "Declared parent node path; none for roots attached to a stock anchor.",
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "description": "Node path named by a LINK node, when present.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "identity",
        "owner",
