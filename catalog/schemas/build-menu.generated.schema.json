        "parent",
        "parent_item",
        "label",
        "key",
        "page",
        "open_page",
        "event",
        "input",
        "activate",
        "fn_action",
        "q_assignable",
        "node_size",
        "cursor_active",
        "binding_id"
      ],
      "type": "object"
    },
    "InlineChoices": {
      "additionalProperties": false,
      "description": "Compiler-declared canvas choice observation.",
      "properties": {
        "accepted_values": {
          "description": "Selectable values.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        },
        "callback": {
          "description": "Callback.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "count": {
          "description": "Count.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "host": {
          "description": "Host.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "identity": {
          "description": "identity.",
          "type": "string"
        },
        "last_value": {
          "description": "Last value.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "mod": {
          "description": "owning_mod.",
          "type": "string"
        },
        "name": {
          "description": "name.",
          "type": "string"
        },
        "owner": {
          "description": "Owner.",
