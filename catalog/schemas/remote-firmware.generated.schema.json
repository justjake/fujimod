          "$ref": "#/$defs/MenuNavigation",
          "description": "Tab navigation bounds."
        },
        "page_tabs": {
          "additionalProperties": false,
          "description": "Root indices mapped to first tab keys.",
          "patternProperties": {
            "^\\d+$": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "q_grid": {
          "$ref": "#/$defs/QuickGrid",
          "description": "Quick menu geometry and menu ID."
        },
        "roles": {
          "additionalProperties": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "description": "Named root indices.",
          "type": "object"
        },
        "root_count": {
          "description": "Number of root pointers.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "root_routes": {
          "additionalProperties": false,
          "description": "Declared root entry strategies.",
          "patternProperties": {
            "^\\d+$": {
              "$ref": "#/$defs/RootRoute"
            }
          },
          "type": "object"
        },
        "root_titles": {
          "additionalProperties": false,
          "description": "Root indices mapped to caption resource IDs.",
          "patternProperties": {
            "^\\d+$": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "roots_address": {
          "description": "Address of the root pointer table.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
