{
  "$defs": {
    "FlashCodeRange": {
      "additionalProperties": false,
      "description": "Stock instruction range.",
      "properties": {
        "address": {
          "description": "First CPU address.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "Role of these instructions.",
          "type": "string"
        },
        "size": {
          "description": "Length in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "address",
        "size"
      ],
      "type": "object"
    },
    "FlashControl": {
      "additionalProperties": false,
      "description": "Update-backed initial read.",
      "properties": {
        "offset": {
          "description": "Offset in the flash window.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "description": "Length in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "offset",
        "size"
      ],
      "type": "object"
    },
    "FlashDevice": {
      "additionalProperties": false,
      "description": "Installed internal storage.",
      "properties": {
        "jedec_id": {
          "description": "Six lowercase hexadecimal JEDEC digits in wire order.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "description": "Serial NAND, serial NOR or raw NAND.",
          "type": "string"
        },
        "part": {
          "description": "Manufacturer and part number.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "FlashRange": {
      "additionalProperties": false,
      "description": "Half-open reader source span.",
      "properties": {
        "address": {
          "description": "First source address or physical byte offset.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "description": "Length in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "address",
        "size"
      ],
      "type": "object"
    },
    "FlashReader": {
      "additionalProperties": false,
      "description": "Stock read request ABI.",
      "properties": {
        "alignment": {
          "description": "Required destination, source and size alignment.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "nand": {
          "anyOf": [
            {
              "$ref": "#/$defs/NandPageReader"
            },
            {
              "type": "null"
            }
          ],
          "description": "Parallel NAND page ABI, absent for memory-window readers."
        },
        "symbol": {
          "description": "Symbol used to link the payload.",
          "type": "string"
        }
      },
      "required": [
        "symbol",
        "alignment"
      ],
      "type": "object"
    },
    "FlashStateCheck": {
      "additionalProperties": false,
      "description": "Driver state that must match before reading.",
      "properties": {
        "address": {
          "description": "CPU address.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "Meaning of the state.",
          "type": "string"
        },
        "size": {
          "description": "Word width in bytes.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "description": "Required little-endian value.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "address",
        "size",
        "value"
      ],
      "type": "object"
    },
    "FlashUpdateImage": {
      "additionalProperties": false,
      "description": "Mapping from update file bytes to flash offsets.",
      "properties": {
        "dat_offset": {
          "description": "File offset corresponding to flash offset zero.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "xor": {
          "description": "Bytewise XOR applied to update bytes.",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "dat_offset",
        "xor"
      ],
      "type": "object"
    },
    "NandPageReader": {
      "additionalProperties": false,
      "description": "Stock eight-argument page read: (page, count, destination, controller_mode,\nevent_mode, timeout_ms, NULL observer, zero-initialized progress word).\nThe caller must acquire `lock` before the read and call `unlock` afterward.",
      "properties": {
        "controller_mode": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "destination_alignment": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "event_mode": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "lock": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_pages_per_call": {
          "description": "One page per call, matching the stock physical-page caller.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "page_bytes": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pages_per_block": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "timeout_ms": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "unlock": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "page_bytes",
        "pages_per_block",
        "destination_alignment",
        "controller_mode",
        "event_mode",
        "timeout_ms",
        "max_pages_per_call",
        "lock",
        "unlock"
      ],
      "type": "object"
    }
  },
  "$id": "https://fujimod.com/schemas/flash.generated.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Stock flash-read contract for one firmware.",
  "properties": {
    "$schema": {
      "const": "https://fujimod.com/schemas/flash.generated.schema.json",
      "description": "Stable schema identifier for this document.",
      "type": "string"
    },
    "code_ranges": {
      "description": "Stock instruction spans checked before running the reader.",
      "items": {
        "$ref": "#/$defs/FlashCodeRange"
      },
      "type": "array"
    },
    "control": {
      "$ref": "#/$defs/FlashControl",
      "description": "Initial update-backed control read."
    },
    "device": {
      "$ref": "#/$defs/FlashDevice",
      "description": "Installed device, checked against the stock driver."
    },
    "firmware_id": {
      "description": "Firmware whose bytes establish this contract.",
      "type": "string"
    },
    "id": {
      "description": "Stable document identity.",
      "type": "string"
    },
    "reader": {
      "$ref": "#/$defs/FlashReader",
      "description": "Stock reader ABI and alignment."
    },
    "schema": {
      "description": "Document version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "state_checks": {
      "description": "Live driver preconditions.",
      "items": {
        "$ref": "#/$defs/FlashStateCheck"
      },
      "type": "array"
    },
    "transport": {
      "description": "Processor-specific payload transport, absent when unresolved.",
      "type": [
        "string",
        "null"
      ]
    },
    "update_image": {
      "$ref": "#/$defs/FlashUpdateImage",
      "description": "Update packaging that supplies comparison bytes."
    },
    "window": {
      "$ref": "#/$defs/FlashRange",
      "description": "Reader source span: CPU aperture or physical NAND byte offsets."
    }
  },
  "required": [
    "$schema",
    "schema",
    "id",
    "firmware_id",
    "device",
    "window",
    "update_image",
    "reader",
    "code_ranges",
    "state_checks",
    "control"
  ],
  "title": "FirmwareFlash",
  "type": "object"
}
