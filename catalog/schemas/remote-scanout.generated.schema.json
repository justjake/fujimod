{
  "$defs": {
    "PixelFormat": {
      "description": "Implemented scanout encodings.",
      "enum": [
        "bgra8888",
        "rgba8888_premultiplied"
      ],
      "type": "string"
    }
  },
  "$id": "https://fujimod.com/schemas/remote-scanout.generated.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A located framebuffer and its live selection pointer.",
  "properties": {
    "address": {
      "anyOf": [
        {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "Observed framebuffer address, or null when this metadata is not established."
    },
    "address_mask": {
      "description": "Address mask.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "channel": {
      "anyOf": [
        {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "Observed display channel, or null when this metadata is not established."
    },
    "height": {
      "description": "Height.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "instance": {
      "anyOf": [
        {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "Display instance required by board-backed frame capture, or null when unavailable."
    },
    "layer": {
      "anyOf": [
        {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "description": "Observed display layer, or null when this metadata is not established."
    },
    "pixel_format": {
      "$ref": "#/$defs/PixelFormat",
      "description": "Pixel format."
    },
    "pointer_address": {
      "description": "Pointer address.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "stride_bytes": {
      "description": "Stride bytes.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "width": {
      "description": "Width.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "address",
    "width",
    "height",
    "pixel_format",
    "stride_bytes",
    "instance",
    "layer",
    "channel",
    "pointer_address",
    "address_mask"
  ],
  "title": "Scanout",
  "type": "object"
}
