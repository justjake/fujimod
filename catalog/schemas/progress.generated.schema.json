{
  "$defs": {
    "FactCount": {
      "additionalProperties": false,
      "description": "How many of a firmware's facts were located.",
      "properties": {
        "located": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "total": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "located",
        "total"
      ],
      "type": "object"
    },
    "ModProgress": {
      "description": "Latest walkthrough result of one mod.",
      "oneOf": [
        {
          "enum": [
            "pass",
            "fail",
            "not-run"
          ],
          "type": "string"
        },
        {
          "const": "unavailable",
          "description": "The mod cannot be built for this firmware.",
          "type": "string"
        },
        {
          "const": "stale",
          "description": "Recorded, but its inputs changed since.",
          "type": "string"
        }
      ]
    },
    "StageEntry": {
      "additionalProperties": false,
      "description": "One bring-up stage and its latest result.",
      "properties": {
        "id": {
          "description": "Stable stage identifier.",
          "type": "string"
        },
        "result": {
          "$ref": "#/$defs/StageProgress"
        },
        "title": {
          "description": "Stage title as the bring-up runner prints it.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "result"
      ],
      "type": "object"
    },
    "StageProgress": {
      "description": "Latest result of one stage.",
      "oneOf": [
        {
          "enum": [
            "pass",
            "fail",
            "not-run"
          ],
          "type": "string"
        },
        {
          "const": "partial",
          "description": "Some of the stage's graded parts pass (stock features, mod walkthroughs).",
          "type": "string"
        },
        {
          "const": "stale",
          "description": "Recorded, but its inputs changed since.",
          "type": "string"
        }
      ]
    },
    "StockProgress": {
      "additionalProperties": false,
      "description": "Latest grade of one stock-feature walkthrough.",
      "properties": {
        "passed": {
          "description": "Graded parts that pass, for features graded in parts.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "result": {
          "$ref": "#/$defs/StockResult"
        },
        "total": {
          "description": "Graded parts in total.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [
        "result"
      ],
      "type": "object"
    },
    "StockResult": {
      "description": "Grade of one stock feature.",
      "oneOf": [
        {
          "enum": [
            "pass",
            "fail",
            "not-run"
          ],
          "type": "string"
        },
        {
          "const": "partial",
          "description": "Some graded parts pass.",
          "type": "string"
        },
        {
          "const": "stale",
          "description": "Recorded, but its inputs changed since.",
          "type": "string"
        }
      ]
    },
    "TrackProgress": {
      "additionalProperties": false,
      "description": "One bring-up track: static analysis, emulator, camera, FujiMod, or SD card and install.",
      "properties": {
        "id": {
          "description": "Stable track identifier.",
          "type": "string"
        },
        "stages": {
          "description": "The track's stages, in order.",
          "items": {
            "$ref": "#/$defs/StageEntry"
          },
          "type": "array"
        },
        "title": {
          "description": "Track title as the bring-up runner prints it.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "stages"
      ],
      "type": "object"
    }
  },
  "$id": "https://fujimod.com/schemas/progress.generated.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Bring-up progress toward FujiMod on one firmware.",
  "properties": {
    "$schema": {
      "const": "https://fujimod.com/schemas/progress.generated.schema.json",
      "description": "Stable schema identifier for this document.",
      "type": "string"
    },
    "boot_rom": {
      "description": "Camera model whose boot ROM dump this firmware boots with, if any.",
      "type": [
        "string",
        "null"
      ]
    },
    "facts": {
      "anyOf": [
        {
          "$ref": "#/$defs/FactCount"
        },
        {
          "type": "null"
        }
      ],
      "description": "Located firmware facts, when the firmware has a facts document."
    },
    "firmware_id": {
      "description": "Firmware the progress belongs to.",
      "type": "string"
    },
    "model": {
      "description": "Camera model name, as the camera reports it.",
      "type": "string"
    },
    "mods": {
      "additionalProperties": {
        "$ref": "#/$defs/ModProgress"
      },
      "description": "Walkthrough result of every shipped mod, by mod name.",
      "type": "object"
    },
    "schema": {
      "description": "Document version.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "stock": {
      "additionalProperties": {
        "$ref": "#/$defs/StockProgress"
      },
      "description": "Stock camera features the emulator is graded on, by feature; only features the body has.",
      "type": "object"
    },
    "tracks": {
      "description": "Bring-up tracks and their stages, in the bring-up graph's order.",
      "items": {
        "$ref": "#/$defs/TrackProgress"
      },
      "type": "array"
    },
    "version": {
      "description": "Firmware version.",
      "type": "string"
    }
  },
  "required": [
    "$schema",
    "schema",
    "firmware_id",
    "model",
    "version",
    "tracks",
    "stock",
    "mods"
  ],
  "title": "FirmwareProgress",
  "type": "object"
}
