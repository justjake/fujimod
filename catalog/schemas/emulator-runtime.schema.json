  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema": {
      "const": 1
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "firmware": {
      "type": "string",
      "minLength": 1
    },
    "update": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "size",
        "sha256"
      ],
      "additionalProperties": false
    },
    "flash_offset": {
      "type": "integer",
      "minimum": 0
    },
    "boot_rom": {
      "type": "object",
      "properties": {
        "content": {
          "type": "object",
          "properties": {
            "size": {
              "type": "integer",
              "minimum": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "size",
            "sha256"
          ],
          "additionalProperties": false
        },
        "address": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "content",
        "address"
      ],
      "additionalProperties": false
    },
    "quantum": {
      "type": "integer",
      "minimum": 1
    },
