          "register": {
            "type": "object",
            "properties": {
              "cp": {
                "type": "integer",
                "minimum": 0
              },
              "wide": {
                "type": "boolean"
              },
              "secure": {
                "type": "integer",
                "minimum": 0
              },
              "crn": {
                "type": "integer",
                "minimum": 0
              },
              "crm": {
                "type": "integer",
                "minimum": 0
              },
              "opc1": {
                "type": "integer",
                "minimum": 0
              },
              "opc2": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "cp",
              "wide",
              "secure",
              "crn",
              "crm",
              "opc1",
              "opc2"
            ],
            "additionalProperties": false
          },
          "set_bits": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "core",
          "register",
          "set_bits"
        ],
        "additionalProperties": false
      }
    },
    "observation": {
      "type": "object",
      "properties": {
        "ui_mode": {
          "type": "integer",
          "minimum": 0
