        "menu_node": {
          "type": "integer",
          "minimum": 0
        },
        "rec_mode": {
          "type": "integer",
          "minimum": 0
        },
        "setup_mode": {
          "type": "integer",
          "minimum": 0
        },
        "instance": {
          "type": "integer",
          "minimum": 0
        },
        "scanout": {
          "type": "string",
          "minLength": 1
        },
        "readiness": {
          "type": "object",
          "properties": {
            "category_one": {
              "type": "integer",
              "minimum": 0
            },
            "category_two": {
              "type": "integer",
              "minimum": 0
            },
            "input_pending": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "override_address": {
              "type": "integer",
              "minimum": 0
            },
            "excluded_mask": {
              "type": "integer",
              "minimum": 0
            },
            "operation_alert_timer": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          "required": [
            "category_one",
            "category_two",
            "input_pending",
            "override_address",
            "excluded_mask",
            "operation_alert_timer"
          ],
          "additionalProperties": false
        }
