                "required": [
                  "kind"
                ],
                "additionalProperties": true
              }
            },
            "required": [
              "name",
              "boot_entries",
              "windows",
              "dependencies",
              "model"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schema",
        "boot_entry",
        "wires",
        "nodes"
      ],
      "additionalProperties": false
    },
    "scene": {
      "type": "object"
    },
    "generated_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "pattern": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            },
            "minItems": 1
          },
          "size": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "name",
          "pattern",
          "size"
        ],
        "additionalProperties": false
      }
