      "type": "object",
      "properties": {
        "processors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "model": {
                "enum": [
                  "cortex-r5f",
                  "cortex-m4",
                  "armv8a",
                  "cortex-a7"
                ]
              },
              "registers": {
                "type": "array",
                "items": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "released": {
                "type": "boolean"
              },
              "mprofile": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "rprofile": {
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "required": [
              "model",
              "registers",
              "released",
              "mprofile",
              "rprofile"
            ],
            "additionalProperties": false
          }
        },
        "ram": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "base": {
                "type": "integer",
                "minimum": 0
              },
              "size": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "base",
              "size"
            ],
            "additionalProperties": false
          }
        },
        "mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "core": {
                "type": "integer",
                "minimum": 0
              },
              "address": {
                "type": "integer",
                "minimum": 0
              },
              "physical": {
                "type": "integer",
                "minimum": 0
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "permissions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              }
            },
            "required": [
              "core",
              "address",
              "physical",
              "size",
              "permissions"
            ],
            "additionalProperties": false
          }
        },
        "peripherals": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "core": {
                "type": "integer",
                "minimum": 0
              },
              "address": {
                "type": "integer",
                "minimum": 0
              },
              "physical": {
                "type": "integer",
                "minimum": 0
              },
              "size": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "core",
              "address",
              "physical",
              "size"
            ],
            "additionalProperties": false
          }
        },
        "dma_mappings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "address": {
                "type": "integer",
                "minimum": 0
              },
              "physical": {
                "type": "integer",
                "minimum": 0
              },
              "size": {
                "type": "integer",
                "minimum": 1
              },
              "permissions": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              }
            },
            "required": [
              "address",
              "physical",
              "size",
              "permissions"
            ],
            "additionalProperties": false
          }
        },
        "instructions_per_tick": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 2,
          "maxItems": 2
        },
        "decoders": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "initial": {
                "type": "integer",
                "minimum": 0
              },
              "choices": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "processors": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "core": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "address": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "physical": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "size": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "permissions": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 7
                          }
                        },
                        "required": [
                          "core",
                          "address",
                          "physical",
                          "size",
                          "permissions"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "dma": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "address": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "physical": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "size": {
                            "type": "integer",
                            "minimum": 1
                          },
                          "permissions": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 7
                          }
                        },
                        "required": [
                          "address",
                          "physical",
                          "size",
                          "permissions"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "processors",
                    "dma"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "initial",
              "choices"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "processors",
        "ram",
        "mappings",
        "peripherals",
        "dma_mappings",
        "instructions_per_tick",
        "decoders"
      ],
      "additionalProperties": false
    },
    "devices": {
      "type": "object",
      "properties": {
        "schema": {
          "const": 1
        },
        "boot_entry": {
          "enum": [
            "rom",
            "loader"
          ]
        },
        "wires": {
          "type": "object"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "boot_entries": {
                "type": "array",
                "items": {
                  "enum": [
                    "rom",
                    "loader"
                  ]
                }
              },
              "windows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "base": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "base",
                    "size"
                  ],
                  "additionalProperties": false
                }
              },
              "dependencies": {
                "type": "array",
