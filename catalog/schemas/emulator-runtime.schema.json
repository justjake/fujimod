      "required": [
        "ui_mode",
        "system_mode",
        "menu_active",
        "pending_mode",
        "menu_node",
        "rec_mode",
        "setup_mode",
        "instance",
        "scanout",
        "readiness"
      ],
      "additionalProperties": false
    },
    "first_start": {
      "type": "object",
      "properties": {
        "channel": {
          "type": "integer",
          "minimum": 0
        },
        "calibration_pointer": {
          "type": "integer",
          "minimum": 0
        },
        "lower_offset": {
          "type": "integer",
          "minimum": 0
        },
        "upper_offset": {
          "type": "integer",
          "minimum": 0
        },
        "adc": {
          "type": "string",
          "minLength": 1
        },
        "hold_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "settle_ticks": {
          "type": "integer",
          "minimum": 1
        },
        "max_presses": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "channel",
        "calibration_pointer",
        "lower_offset",
        "upper_offset",
        "adc",
        "hold_ticks",
        "settle_ticks",
        "max_presses"
      ],
      "additionalProperties": false
    }
