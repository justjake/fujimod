  "required": [
    "$schema",
    "schema",
    "body",
    "firmware",
    "update",
    "flash_offset",
    "boot_rom",
    "quantum",
    "execution",
    "devices",
    "scene",
    "generated_assets",
    "mcu",
    "reset_coprocessors",
    "observation",
    "first_start"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fujimod.com/schemas/emulator-runtime.schema.json",
  "title": "Standalone emulator runtime",
  "description": "Processor graph, physical device parameters, external scene generation and host boot observations. Device model variants are checked by the Rust Plan parser."
}
