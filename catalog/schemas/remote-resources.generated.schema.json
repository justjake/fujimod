{
  "$defs": {
    "BitmapLayout": {
      "additionalProperties": false,
      "description": "Bitmap record fields, with explicit widths.",
      "properties": {
        "data_bytes": {
          "description": "Data bytes.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "data_offset": {
          "description": "Data offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "height_bytes": {
          "description": "Height bytes.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "height_offset": {
          "description": "Height offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "kind_bytes": {
          "description": "Kind bytes.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "kind_offset": {
          "description": "Kind offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "width_bytes": {
          "description": "Width bytes.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "width_offset": {
          "description": "Width offset.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "data_bytes",
        "data_offset",
        "height_bytes",
        "height_offset",
        "kind_bytes",
        "kind_offset",
        "width_bytes",
        "width_offset"
      ],
      "type": "object"
    },
    "BitmapResources": {
      "additionalProperties": false,
      "description": "Native bitmap descriptor table layout.",
      "properties": {
        "final_first_index": {
          "description": "Final first index.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "final_table": {
          "description": "Final table.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "last_index": {
          "description": "Last index.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "last_record": {
          "description": "Last record.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "layout": {
          "$ref": "#/$defs/BitmapLayout",
          "description": "Layout."
        },
        "stride": {
          "description": "Stride.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "table": {
          "description": "Table.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "table",
        "stride",
        "final_table",
        "final_first_index",
        "last_index",
        "last_record",
        "layout"
      ],
      "type": "object"
    },
    "ConfigurationLocation": {
      "description": "A configuration block addressed directly or through a firmware pointer.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Firmware address containing a configuration-block pointer.",
          "properties": {
            "address": {
              "description": "Pointer address.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "pointer",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "address"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Fixed configuration-block base address.",
          "properties": {
            "address": {
              "description": "Block address.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "direct",
              "type": "string"
            }
          },
          "required": [
            "kind",
            "address"
          ],
          "type": "object"
        }
      ]
    },
    "GlyphResources": {
      "additionalProperties": false,
      "description": "Registry layout locating the native icon font resource.",
      "properties": {
        "data_address_offset": {
          "description": "Byte offset of the font data pointer.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "data_size_offset": {
          "description": "Byte offset of the font byte length.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "icon_index": {
          "description": "Icon font record index.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "record_size": {
          "description": "Registry record size in bytes.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "registry_address": {
          "description": "Resource registry base address.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "registry_address",
        "record_size",
        "icon_index",
        "data_address_offset",
        "data_size_offset"
      ],
      "type": "object"
    }
  },
