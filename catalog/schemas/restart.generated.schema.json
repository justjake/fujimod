{
  "$defs": {
    "AlarmRegisters": {
      "additionalProperties": false,
      "description": "Power-controller registers the power-off writes for the wake alarm.",
      "properties": {
        "enable": {
          "description": "Register that enables the alarm.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "enable_value": {
          "description": "Value written to enable it.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "seconds": {
          "description": "Registers holding the seconds until the alarm, least significant first.",
          "items": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          },
          "type": "array"
        }
      },
      "required": [
        "seconds",
        "enable",
        "enable_value"
      ],
      "type": "object"
    },
    "CodeCheck": {
      "additionalProperties": false,
      "description": "Stock code bytes identified by their SHA-256.",
      "properties": {
        "address": {
          "description": "First address, before `code_alias`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "Routine or region name.",
          "type": "string"
        },
        "sha256": {
          "description": "Lowercase hexadecimal SHA-256 of the stock bytes.",
          "type": "string"
        },
        "size": {
          "description": "Length in bytes.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "name",
        "address",
        "size",
        "sha256"
      ],
      "type": "object"
    },
    "DeferredTimer": {
      "additionalProperties": false,
      "description": "A stock timer that calls a no-argument callback after a millisecond delay.",
      "properties": {
        "callback_arguments": {
          "description": "Number of arguments passed to the callback.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "cancel": {
          "$ref": "#/$defs/TimerRoutine",
          "description": "Stock routine that cancels the handle returned by `start`."
        },
        "kind": {
          "description": "Normalized ABI identifier.",
          "type": "string"
        },
        "one_shot_periodic": {
          "description": "Value of the periodic selector for a one-shot callback.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "period_unit": {
          "description": "Unit accepted by `start`'s first argument.",
          "type": "string"
        },
        "periodic_nonzero": {
          "description": "Whether nonzero selector values repeat the callback.",
          "type": "boolean"
        },
        "start": {
          "$ref": "#/$defs/TimerRoutine",
          "description": "Stock routine that starts a timer."
        }
      },
      "required": [
        "kind",
        "period_unit",
        "one_shot_periodic",
        "periodic_nonzero",
        "callback_arguments",
        "start",
        "cancel"
      ],
      "type": "object"
    },
