    "EarlyBootMechanism": {
      "description": "A processor-specific freestanding power-controller transport.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Polled EXR II SPI, persistent packet, wake alarm and power-hold release.",
          "properties": {
            "code_checks": {
              "description": "Stock loader ranges establishing the transport.",
              "items": {
                "$ref": "#/$defs/CodeCheck"
              },
              "type": "array"
            },
            "constants": {
              "$ref": "#/$defs/EarlyBootConstants",
              "description": "Exact C constants derived from the checked loader and power path."
            },
            "kind": {
              "const": "exr2_polled_alarm",
              "type": "string"
            },
            "spi_channel": {
              "description": "SPI channel selected by the verified loader descriptor.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "spi_channel",
            "constants",
            "code_checks"
          ],
          "type": "object"
        }
      ]
    },
    "PowerOff": {
      "additionalProperties": false,
      "description": "The stock power-off reached by the request.",
      "properties": {
        "alarm": {
          "$ref": "#/$defs/AlarmRegisters",
          "description": "Power-controller registers for the alarm."
        },
        "deadline_parameter": {
          "description": "Persistent power-controller parameter offset of the saved deadline\nword, where the power-off saves it.",
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "entry": {
          "description": "Stock power-off routine.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "halt": {
          "description": "Its final self-branch, reached after the power cut.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "power_cut": {
          "description": "Stock routine that cuts power.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "request_deadline_offset": {
          "description": "Byte offset of the deadline in the request the power-off receives.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "rollover_parameter": {
          "description": "Persistent parameter offset of the alarm's rollover byte.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "entry",
        "halt",
        "power_cut",
        "request_deadline_offset",
        "alarm",
        "rollover_parameter"
      ],
      "type": "object"
    },
    "RecIdle": {
      "additionalProperties": false,
      "description": "UI state that is REC with nothing pending and no menu open.",
      "properties": {
        "menu_active_address": {
          "description": "Nonzero while a menu is open, where located.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "mode_address": {
          "description": "Current UI mode.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "mode_size": {
          "description": "Bytes in each UI mode cell.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "pending_mode_address": {
          "description": "Pending UI mode, zero when no change is pending, where located.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "rec_mode": {
          "description": "UI mode value for REC.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "mode_address",
        "mode_size",
        "rec_mode"
      ],
      "type": "object"
    },
    "RequestTransport": {
      "description": "How the host makes the camera call the sender.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "A borrowed diagnostic query calls the sender with the address of the\nquery output fields, which hold the parameters.",
          "properties": {
            "callback_offset": {
              "description": "Byte offset of the query callback in that table.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "callback_table": {
              "description": "Address of the pointer to the diagnostic callback table.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "borrowed_query",
              "type": "string"
            },
            "output_bytes": {
              "description": "Bytes in the output fields.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "output_fields": {
              "description": "Output fields passed to the callback; the query tag is their address.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "stock_callback": {
              "description": "Stock callback value.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "callback_table",
            "callback_offset",
            "stock_callback",
            "output_fields",
            "output_bytes"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "The debug console's command callback is pointed at a short stub in an\nunused executable area. The stub passes its parameters to the sender\nand returns through it; the stock callback is restored after the reply.",
          "properties": {
            "data_cache_clean": {
              "description": "Stock routine that cleans the data cache on every core.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "instruction_cache_sync": {
              "description": "Stock routine that invalidates the instruction cache.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "kind": {
              "const": "console_callback",
              "type": "string"
            },
            "ready_words": {
              "description": "Words showing the stock cache maintenance is ready on every core.",
              "items": {
                "$ref": "#/$defs/WordValue"
              },
              "type": "array"
            },
            "slot": {
              "description": "Command callback slot (a pointer the console calls for `CMD`).",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "stock_callback": {
              "description": "Stock callback value the slot must hold and gets back.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "stub_area": {
              "description": "Unused executable area for the stub; it must read as zero.",
              "format": "uint64",
              "minimum": 0,
              "type": "integer"
            },
            "stub_bytes": {
              "description": "Bytes of the stub area.",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "translation": {
              "description": "Translation entries that keep the stub area executable.",
              "items": {
                "$ref": "#/$defs/WordValue"
              },
              "type": "array"
            }
          },
          "required": [
            "kind",
            "slot",
            "stock_callback",
            "stub_area",
            "stub_bytes",
            "translation",
            "ready_words",
            "data_cache_clean",
            "instruction_cache_sync"
          ],
          "type": "object"
        }
      ]
    },
    "RestartMechanism": {
      "additionalProperties": false,
      "description": "The stock power-off request with a wake deadline. The power-off arms the\npower controller's alarm and cuts power; the alarm boots the camera again.",
      "properties": {
        "deadline_offset": {
          "description": "Byte offset of the wake deadline in the sender's parameters.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "deferred_timer": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeferredTimer"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional stock timer ABI for an autonomous deferred restart. This is\npresent only when its locator qualified a callback timer on the same\nfirmware; delivery and callback placement remain separate mechanisms."
        },
        "early_boot": {
          "anyOf": [
            {
              "$ref": "#/$defs/EarlyBootMechanism"
            },
            {
              "type": "null"
            }
          ],
          "description": "Freestanding restart before the operating system, when located."
        },
        "parameter_bytes": {
          "description": "Bytes of sender parameters.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "power_off": {
          "$ref": "#/$defs/PowerOff",
          "description": "What the stock power-off does with the request."
        },
        "request": {
          "description": "Request word that selects power-off with a wake.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "request_offset": {
          "description": "Byte offset of the request word in the sender's parameters.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "sender": {
          "description": "Stock routine that sends the power-off request; its first argument is\nthe address of the request parameters.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "transport": {
          "$ref": "#/$defs/RequestTransport",
          "description": "How the host reaches the sender."
        },
        "ui": {
          "$ref": "#/$defs/RecIdle",
          "description": "Where REC idle is observed."
        }
      },
      "required": [
        "transport",
        "sender",
        "request",
        "request_offset",
        "deadline_offset",
        "parameter_bytes",
        "ui",
        "power_off"
      ],
      "type": "object"
    },
    "TimerRoutine": {
      "additionalProperties": false,
      "description": "A bounded stock routine that Rust verifies before using the timer ABI.",
      "properties": {
        "address": {
          "description": "Entry address before `code_alias`.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "description": "Exact routine bytes covered by the matching code check.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "address",
        "size"
      ],
      "type": "object"
    },
    "WordValue": {
      "additionalProperties": false,
      "description": "An exact memory word.",
      "properties": {
        "address": {
          "description": "Address of the word.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "description": "Bytes in the word: 4 or 8.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "value": {
          "description": "Value, little-endian.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "address",
        "size",
        "value"
      ],
      "type": "object"
    }
  },
  "$id": "https://fujimod.com/schemas/restart.generated.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Located restart for one firmware.",
  "properties": {
    "$schema": {
      "const": "https://fujimod.com/schemas/restart.generated.schema.json",
      "description": "Stable schema identifier for this document.",
      "type": "string"
    },
    "code_alias": {
      "description": "Uncached RAM alias: debug reads of code, the callback table pointer,\nthe callback slot and UI state use `address + code_alias`.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "code_checks": {
      "description": "Stock code that must match before any write.",
      "items": {
        "$ref": "#/$defs/CodeCheck"
      },
      "type": "array"
    },
    "firmware_id": {
      "description": "Firmware whose stock code provides this mechanism.",
      "type": "string"
    },
    "id": {
      "description": "Stable document identity.",
      "type": "string"
    },
    "internal_version": {
      "description": "Internal version the camera reports.",
      "type": "string"
    },
    "mechanism": {
      "$ref": "#/$defs/RestartMechanism",
      "description": "How the restart is requested."
    },
    "product": {
      "description": "Product name the camera reports.",
